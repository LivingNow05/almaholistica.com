---
/**
 * src/components/FloatingWhatsApp.astro — Botón Flotante Interactivo de WhatsApp
 *
 * Reemplaza la barra fija inferior de móvil por un botón flotante circular de alta conversión,
 * idéntico al estándar consolidado en unperro.com y consultor-ia.com.co.
 *
 * Características:
 * - Posicionamiento fijo en esquina inferior derecha (fixed bottom-6 right-6 z-50).
 * - Animación de pulso verde suave (btn-pulse) para capturar atención sin ser intrusivo.
 * - Micro-etiqueta lateral "💬 ¿Hablamos?" para disparar clics de consulta.
 * - Icono SVG oficial de WhatsApp en blanco puro.
 * - Integración con WhatsAppQuizModal (data-open-quiz="true") y fallback directo a wa.me.
 */
import { buildWhatsAppUrl } from '../config/site';

export interface Props {
  symptom?: string;
  location?: string;
}

const {
  symptom,
  location = 'Boton Flotante WhatsApp Global'
} = Astro.props;

const whatsappUrl = buildWhatsAppUrl({
  symptom,
  location
});
---

<div class="fixed bottom-6 right-6 z-50 flex items-center print:hidden">
  <a
    href={whatsappUrl}
    id="floating-whatsapp-cta"
    data-open-quiz="true"
    data-location="floating-whatsapp-button"
    data-symptom={symptom || ''}
    class="relative group btn-pulse bg-[#25D366] hover:bg-[#20ba5a] text-white w-14 h-14 sm:w-16 sm:h-16 rounded-full shadow-2xl flex items-center justify-center transition-all duration-300 hover:scale-110 focus:outline-none focus:ring-4 focus:ring-[#25D366]/40 cursor-pointer"
    aria-label="Contactar por WhatsApp — Iniciar evaluación personalizada"
  >
    <!-- Micro-etiqueta lateral izquierda -->
    <span
      class="absolute right-full mr-3.5 top-1/2 -translate-y-1/2 bg-white text-slate-800 text-xs sm:text-sm font-sans font-bold px-3.5 py-1.5 sm:py-2 rounded-xl shadow-lg whitespace-nowrap border border-slate-100 pointer-events-none transition-all duration-300 group-hover:scale-105"
      aria-hidden="true"
    >
      💬 ¿Hablamos?
    </span>

    <!-- Icono SVG oficial de WhatsApp -->
    <svg
      class="w-7 h-7 sm:w-8 sm:h-8 fill-current text-white transform transition-transform duration-300 group-hover:rotate-6"
      viewBox="0 0 24 24"
      width="32"
      height="32"
      aria-hidden="true"
    >
      <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.23 8.23 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.39-1.72-.14-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.49-.4-.42-.56-.43h-.47c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.77 2.7 4.29 3.78.6.26 1.07.41 1.43.53.6.19 1.15.16 1.58.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.18-.47-.31"/>
    </svg>
  </a>
</div>

<style>
  @keyframes pulse-ring {
    0% {
      box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.7);
    }
    70% {
      box-shadow: 0 0 0 16px rgba(37, 211, 102, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(37, 211, 102, 0);
    }
  }

  .btn-pulse {
    animation: pulse-ring 2.2s infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-pulse {
      animation: none;
    }
  }
</style>
