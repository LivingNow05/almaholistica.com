</header>

<script>
  import { TRANSLATIONS, type LangCode } from '../i18n/translations';

  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-open-icon');
  const closeIcon = document.getElementById('menu-close-icon');

  if (btn && menu && openIcon && closeIcon) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      openIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });
  }

  // Alternador de Menús de Idioma (Desktop y Móvil)
  const langBtnDesktop = document.getElementById('lang-btn-desktop');
  const langMenuDesktop = document.getElementById('lang-menu-desktop');
  const langBtnMobile = document.getElementById('lang-btn-mobile');
  const langMenuMobile = document.getElementById('lang-menu-mobile');

  const closeAllLangMenus = () => {
    if (langMenuDesktop) {
      langMenuDesktop.classList.add('hidden');
      langBtnDesktop?.setAttribute('aria-expanded', 'false');
    }
    if (langMenuMobile) {
      langMenuMobile.classList.add('hidden');
      langBtnMobile?.setAttribute('aria-expanded', 'false');
    }
    const backdrop = document.getElementById('lang-backdrop-mobile');
    if (backdrop) {
      backdrop.classList.add('hidden');
    }
  };

  if (langBtnDesktop && langMenuDesktop) {
    langBtnDesktop.addEventListener('click', (e) => {
      e.stopPropagation();
      const isHidden = langMenuDesktop.classList.contains('hidden');
      closeAllLangMenus();
      if (isHidden) {
        langMenuDesktop.classList.remove('hidden');
        langBtnDesktop.setAttribute('aria-expanded', 'true');
      }
    });
  }

  if (langBtnMobile && langMenuMobile) {
    langBtnMobile.addEventListener('click', (e) => {
      e.stopPropagation();
      const isHidden = langMenuMobile.classList.contains('hidden');
      closeAllLangMenus();
      if (isHidden) {
        langMenuMobile.classList.remove('hidden');
        langBtnMobile.setAttribute('aria-expanded', 'true');
        const backdrop = document.getElementById('lang-backdrop-mobile');
        if (backdrop) backdrop.classList.remove('hidden');
      }
    });
  }

  const langCloseBtnMobile = document.getElementById('lang-menu-close-mobile');
  if (langCloseBtnMobile) {
    langCloseBtnMobile.addEventListener('click', (e) => {
      e.stopPropagation();
      closeAllLangMenus();
    });
  }

  const langBackdropMobile = document.getElementById('lang-backdrop-mobile');
  if (langBackdropMobile) {
    langBackdropMobile.addEventListener('click', (e) => {
      e.stopPropagation();
      closeAllLangMenus();
    });
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    if (!target) return;
    if (
      langMenuDesktop &&
      !langMenuDesktop.contains(target) &&
      !langBtnDesktop?.contains(target) &&
      langMenuMobile &&
      !langMenuMobile.contains(target) &&
      !langBtnMobile?.contains(target)
    ) {
      closeAllLangMenus();
    }
  });

  // ========================================================================
  // MOTOR DE TRADUCCIÓN NATIVO CLIENT-SIDE (ES, EN, DE, FR, IT)
  // Cero dependencias externas. Cero scripts o cookies de Google Translate.
  // ========================================================================
  const validLangs: LangCode[] = ['es', 'en', 'de', 'fr', 'it'];

  function updateLangUI(currentLang: string) {
    const langCode = (validLangs.includes(currentLang as LangCode) ? currentLang : 'es') as LangCode;
    const upper = langCode.toUpperCase();

    // Actualizar etiquetas en botones
    const labelDesktop = document.getElementById('lang-current-label-desktop');
    if (labelDesktop) labelDesktop.textContent = upper;
    const labelMobile = document.getElementById('lang-current-label-mobile');
    if (labelMobile) labelMobile.textContent = upper;

    // Actualizar checks en menús desplegables
    document.querySelectorAll('.lang-check').forEach((checkEl) => {
      const el = checkEl as HTMLElement;
      const checkLang = el.getAttribute('data-check-lang');
      if (checkLang === langCode) {
        el.classList.remove('hidden');
      } else {
        el.classList.add('hidden');
      }
    });

    // Actualizar píldoras/botones del menú móvil drawer
    validLangs.forEach((l) => {
      const pills = document.querySelectorAll(`.lang-pill-${l}`);
      pills.forEach((p) => {
        if (l === langCode) {
          p.className = `lang-option-btn lang-pill-btn lang-pill-${l} flex items-center justify-between px-3.5 py-2.5 rounded-xl border text-left font-bold text-xs bg-[#779DD1] text-[#060A1A] border-[#779DD1] transition-all min-h-[44px]`;
        } else {
          p.className = `lang-option-btn lang-pill-btn lang-pill-${l} flex items-center justify-between px-3.5 py-2.5 rounded-xl border text-left font-medium text-xs bg-white dark:bg-[#0E172F] text-slate-800 dark:text-slate-200 border-slate-200 dark:border-slate-700 transition-all hover:border-[#779DD1] min-h-[44px]`;
        }
      });
    });
  }

  function getNestedTranslation(obj: any, path: string): string | undefined {
    return path.split('.').reduce((prev, curr) => (prev && prev[curr] !== undefined ? prev[curr] : undefined), obj);
  }

  function applyNativeTranslation(targetLang: string) {
    const langCode = (validLangs.includes(targetLang as LangCode) ? targetLang : 'es') as LangCode;
    closeAllLangMenus();

    // Guardar preferencia local
    try {
      localStorage.setItem('alma_preferred_lang', langCode);
    } catch (e) {}

    // Actualizar atributo html lang
    document.documentElement.lang = langCode;

    // Actualizar estados visuales de los selectores
    updateLangUI(langCode);

    // Obtener diccionario de traducción
    const dict = TRANSLATIONS[langCode] || TRANSLATIONS['es'];

    // Aplicar a todos los elementos con atributo data-i18n
    document.querySelectorAll('[data-i18n]').forEach((el) => {
      const key = el.getAttribute('data-i18n');
      if (!key) return;
      const text = getNestedTranslation(dict, key);
      if (text !== undefined) {
        el.textContent = text;
      }
    });

    // Aplicar a elementos con atributos traducibles data-i18n-attr (ej. "placeholder:quiz.placeholder")
    document.querySelectorAll('[data-i18n-attr]').forEach((el) => {
      const attrConfig = el.getAttribute('data-i18n-attr');
      if (!attrConfig) return;
      attrConfig.split(',').forEach((item) => {
        const [attrName, key] = item.split(':');
        if (attrName && key) {
          const val = getNestedTranslation(dict, key.trim());
          if (val !== undefined) {
            el.setAttribute(attrName.trim(), val);
          }
        }
      });
    });

    // Notificar a componentes interactivos (ej. WhatsAppQuizModal en React)
    window.dispatchEvent(
      new CustomEvent('alma:lang-changed', {
        detail: { lang: langCode, translations: dict }
      })
    );
  }

  // Registrar clics en todos los botones de idioma
  document.querySelectorAll('.lang-option-btn').forEach((btnEl) => {
    btnEl.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      if ((e as any).stopImmediatePropagation) {
        (e as any).stopImmediatePropagation();
      }
      const code = (btnEl.getAttribute('data-lang-code') || '').toLowerCase();
      if (code) {
        applyNativeTranslation(code);
      }
    });
  });

  // Restaurar idioma guardado al cargar
  try {
    const savedLang = localStorage.getItem('alma_preferred_lang');
    if (savedLang && validLangs.includes(savedLang as LangCode) && savedLang !== 'es') {
      applyNativeTranslation(savedLang);
    } else {
      updateLangUI('es');
    }
  } catch (e) {
    updateLangUI('es');
  }

  // Alternador de Tema (Modo Claro / Modo Oscuro)
  const themeToggles = document.querySelectorAll('.theme-toggle-btn');
  const updateThemeUI = (isDark: boolean) => {
    document.querySelectorAll('.theme-sun-icon').forEach((el) => {
      el.classList.toggle('hidden', !isDark);
    });
    document.querySelectorAll('.theme-moon-icon').forEach((el) => {
      el.classList.toggle('hidden', isDark);
    });
  };

  const initialDark = document.documentElement.classList.contains('dark');
  updateThemeUI(initialDark);

  themeToggles.forEach((tBtn) => {
    tBtn.addEventListener('click', () => {
      const currentlyDark = document.documentElement.classList.contains('dark');
      if (currentlyDark) {
        document.documentElement.classList.remove('dark');
        document.documentElement.classList.add('light');
        try {
          localStorage.setItem('theme_preference', 'light');
          localStorage.setItem('theme', 'light');
        } catch (e) {}
        updateThemeUI(false);
      } else {
        document.documentElement.classList.add('dark');
        document.documentElement.classList.remove('light');
        try {
          localStorage.setItem('theme_preference', 'dark');
          localStorage.setItem('theme', 'dark');
        } catch (e) {}
        updateThemeUI(true);
      }
    });
  });
</script>
