---
/**
 * Navbar.astro — Barra de Navegación Global de Alma Holística
 *
 * Estética Editorial de Alta Gama (Inspiración Talora Wellness Group)
 * Fondo Abisal sólido mate (#060A1A) con borde ultra-sutil (border-slate-800/40).
 * Diseño 100% opaco y sobrio, sin transparencias ni efectos de desenfoque.
 * Erradicación total de amarillo/dorado, paleta bi-color (#060A1A y #779DD1).
 * Botón CTA de acción tipo píldora en blanco puro (rounded-full) con hover en Cyan (#779DD1).
 * Trigger interactivo del WhatsApp Quiz Modal (data-open-quiz).
 */

import { buildWhatsAppUrl } from '../config/site';

const currentPath = Astro.url.pathname;
const whatsappCtaUrl = buildWhatsAppUrl({
  location: 'Navegación General'
});
---

<header class="w-full bg-white dark:bg-[#060A1A] border-b border-slate-200 dark:border-slate-800 sticky top-0 z-40 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Logo y Nombre de Marca -->
      <a
        href="/"
        class="flex items-center gap-3.5 group focus:outline-none focus:ring-2 focus:ring-[#779DD1] rounded-lg p-1"
        aria-label="Alma Holística — Ir a Inicio"
      >
        <div class="brand-logo-badge w-11 h-11 relative flex items-center justify-center rounded-full overflow-hidden bg-white border border-slate-200 dark:bg-[#0A1226] dark:border-slate-800 shrink-0 shadow-sm dark:shadow-none">
          <img
            src="/logo-mariposa-con-fondo-completo.svg"
            alt="Alma Holística Logo"
            class="w-full h-full object-contain transform group-hover:scale-110 transition-transform duration-300"
            width="44"
            height="44"
            loading="eager"
          />
        </div>
        <div class="flex flex-col">
          <span class="brand-title font-sans text-xl sm:text-2xl font-bold tracking-tight text-slate-950 dark:text-white group-hover:text-[#779DD1] transition-colors">
            Alma Holística
          </span>
          <span class="text-xs tracking-[0.2em] uppercase text-slate-500 dark:text-[#779DD1] font-sans font-semibold hidden sm:block">
            Biodescodificación & Sanación
          </span>
        </div>
      </a>

      <!-- Navegación de Escritorio -->
      <nav class="hidden md:flex items-center gap-8" aria-label="Navegación principal">
        <a
          href="/"
          class:list={[
            'text-sm font-medium transition-colors hover:text-[#779DD1]',
            currentPath === '/' ? 'text-[#779DD1] font-semibold' : 'text-slate-700 dark:text-slate-300'
          ]}
        >
          Inicio
        </a>
        <a
          href="/biodescodificacion"
          class:list={[
            'text-sm font-medium transition-colors hover:text-[#779DD1]',
            currentPath.startsWith('/biodescodificacion') ? 'text-[#779DD1] font-semibold' : 'text-slate-700 dark:text-slate-300'
          ]}
        >
          Biodescodificación
        </a>
        <a
          href="/#ciudades"
          class="text-sm font-medium text-slate-700 dark:text-slate-300 hover:text-[#779DD1] transition-colors"
        >
          Ciudades
        </a>
        <a
          href="/sobre-nosotros"
          class:list={[
            'inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold tracking-wide transition-all border shadow-sm',
            currentPath.startsWith('/sobre-nosotros')
              ? 'bg-[#779DD1] text-[#060A1A] border-[#779DD1] font-bold'
              : 'bg-slate-100 dark:bg-[#0A1226] text-slate-800 dark:text-slate-200 border-slate-300 dark:border-slate-700 hover:border-[#779DD1] hover:text-[#779DD1]'
          ]}
          aria-label="Sobre Nosotros — Vivian Velásquez"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Sobre Nosotros</span>
        </a>
        <a
          href="https://share.google/otrUm918xRGNHTTkE"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-500/10 text-emerald-950 dark:text-emerald-300 border border-emerald-600/40 dark:border-emerald-500/25 hover:bg-emerald-100 dark:hover:bg-emerald-500/20 transition-all"
          title="Ver reseñas verificadas en Google Maps (4.3 / 5.0)"
        >
          <span class="text-emerald-600 dark:text-emerald-400 text-xs">★</span>
          <span>4.3 en Google Reviews</span>
        </a>
      </nav>

      <!-- Botón CTA WhatsApp, Selector de Idioma & Theme Toggle (Desktop) -->
      <div class="hidden sm:flex items-center gap-3">
        <!-- Selector de Idioma Desktop -->
        <div class="relative language-selector-wrapper">
          <button
            type="button"
            id="lang-btn-desktop"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-slate-100 dark:bg-[#0A1226] text-slate-800 dark:text-slate-200 border border-slate-300 dark:border-slate-800 hover:border-[#779DD1] transition-all cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#779DD1]"
            aria-label="Seleccionar idioma"
            aria-expanded="false"
          >
            <svg class="w-3.5 h-3.5 text-[#779DD1]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="10" stroke-width="1.8"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/>
            </svg>
            <span class="font-bold">ES</span>
            <svg class="w-2.5 h-2.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>

          <!-- Menú flotante de Idioma y Cobertura -->
          <div
            id="lang-menu-desktop"
            class="hidden absolute right-0 mt-2 w-56 rounded-2xl bg-white dark:bg-[#0A1226] border border-slate-200 dark:border-slate-800 shadow-2xl p-2 z-50 text-xs font-sans"
          >
            <div class="px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-slate-400 border-b border-slate-100 dark:border-slate-800/80 mb-1">
              Idioma / Language
            </div>
            <div
              class="w-full flex items-center justify-between px-3 py-2 rounded-xl bg-slate-100 dark:bg-[#0E172F] text-slate-900 dark:text-white font-semibold"
            >
              <span class="flex items-center gap-2">
                <span>🇪🇸</span>
                <span>Español (ES)</span>
              </span>
              <span class="text-emerald-500 font-bold">✓</span>
            </div>
            <a
              href={buildWhatsAppUrl({ location: 'Language Switcher — English Inquiry' })}
              class="w-full flex items-center justify-between px-3 py-2 rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-[#0E172F] transition-colors mt-1"
            >
              <span class="flex items-center gap-2">
                <span>🇺🇸</span>
                <span>English (EN)</span>
              </span>
              <span class="text-[10px] text-[#779DD1] uppercase font-bold">WhatsApp</span>
            </a>
            <div class="mt-2 pt-2 border-t border-slate-100 dark:border-slate-800/80">
              <a
                href="/#paises"
                class="block px-3 py-1.5 rounded-lg text-slate-500 dark:text-slate-400 hover:text-[#779DD1] transition-colors text-[11px]"
              >
                🌎 Ver 20 países y monedas locales &rarr;
              </a>
            </div>
          </div>
        </div>

        <button
          type="button"
          class="theme-toggle-btn w-10 h-10 rounded-full flex items-center justify-center text-slate-700 dark:text-slate-300 hover:text-slate-950 dark:hover:text-white bg-slate-100 dark:bg-[#0A1226] border border-slate-200 dark:border-slate-800 hover:border-[#779DD1] transition-all duration-300 cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#779DD1]"
          aria-label="Alternar modo claro u oscuro"
        >
          <!-- Icono Sol (se muestra en modo oscuro para pasar a claro) -->
          <svg class="theme-sun-icon w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <!-- Icono Luna (se muestra en modo claro para pasar a oscuro) -->
          <svg class="theme-moon-icon w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <a
          href={whatsappCtaUrl}
          data-open-quiz="true"
          data-location="global"
          data-symptom=""
          class="btn-action-pill-white inline-flex items-center gap-2 bg-white text-[#060A1A] px-7 py-2.5 rounded-full text-sm font-medium hover:bg-[#779DD1] hover:text-[#060A1A] transition-all duration-500 shadow-pill-white focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-[#060A1A] focus:ring-[#779DD1]"
        >
          <!-- Icono SVG de WhatsApp (FontAwesome 6 sólido) -->
          <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 448 512" aria-hidden="true">
            <path fill="currentColor" d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
          </svg>
          <span>Agendar Sesión</span>
        </a>
      </div>

      <!-- Botón Menú Móvil, Idioma & Tema -->
      <div class="flex md:hidden items-center gap-2">
        <!-- Selector de Idioma Móvil -->
        <div class="relative language-selector-wrapper">
          <button
            type="button"
            id="lang-btn-mobile"
            class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-full text-xs font-semibold bg-slate-100 dark:bg-[#0A1226] text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-slate-800 hover:border-[#779DD1] transition-all cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#779DD1]"
            aria-label="Seleccionar idioma"
            aria-expanded="false"
          >
            <span>🌐</span>
            <span class="font-bold">ES</span>
          </button>

          <!-- Menú flotante móvil de Idioma -->
          <div
            id="lang-menu-mobile"
            class="hidden absolute right-0 mt-2 w-52 rounded-2xl bg-white dark:bg-[#0A1226] border border-slate-200 dark:border-slate-800 shadow-2xl p-2 z-50 text-xs font-sans"
          >
            <div class="px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-slate-400 border-b border-slate-100 dark:border-slate-800/80 mb-1">
              Idioma / Language
            </div>
            <div class="w-full flex items-center justify-between px-2.5 py-1.5 rounded-xl bg-slate-100 dark:bg-[#0E172F] text-slate-900 dark:text-white font-semibold">
              <span>🇪🇸 Español (ES)</span>
              <span class="text-emerald-500 font-bold">✓</span>
            </div>
            <a
              href={buildWhatsAppUrl({ location: 'Mobile Lang — English Inquiry' })}
              class="w-full flex items-center justify-between px-2.5 py-1.5 rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-[#0E172F] transition-colors mt-1"
            >
              <span>🇺🇸 English (EN)</span>
              <span class="text-[10px] text-[#779DD1] uppercase font-bold">Online</span>
            </a>
            <div class="mt-2 pt-1.5 border-t border-slate-100 dark:border-slate-800/80">
              <a
                href="/#paises"
                class="block px-2 py-1 text-[10px] text-slate-500 dark:text-slate-400 hover:text-[#779DD1] transition-colors"
              >
                🌎 Ver 20 Países y Monedas &rarr;
              </a>
            </div>
          </div>
        </div>

        <button
          type="button"
          class="theme-toggle-btn p-2.5 rounded-full text-slate-700 dark:text-slate-300 hover:text-slate-950 dark:hover:text-white bg-slate-100 dark:bg-[#0A1226] border border-slate-200 dark:border-slate-800 focus:outline-none focus:ring-2 focus:ring-[#779DD1]"
          aria-label="Alternar tema"
        >
          <svg class="theme-sun-icon w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg class="theme-moon-icon w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <button
          type="button"
          id="mobile-menu-button"
          class="p-2.5 rounded-full text-slate-700 dark:text-slate-300 hover:text-slate-950 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-[#0E172F] border border-slate-200 dark:border-slate-800 focus:outline-none focus:ring-2 focus:ring-[#779DD1]"
          aria-label="Abrir menú de navegación"
          aria-expanded="false"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="menu-open-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            <path id="menu-close-icon" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Panel Menú Móvil (Sólido mate, sin transparencias) -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-[#060A1A] px-4 pt-3 pb-6 space-y-3">
    <a
      href="/"
      class:list={[
        'block px-3 py-2 rounded-lg text-base font-medium transition-colors',
        currentPath === '/' ? 'text-[#779DD1] font-semibold bg-slate-100 dark:bg-[#0A1226]' : 'text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-[#0A1226] hover:text-[#779DD1]'
      ]}
    >
      Inicio
    </a>
    <a
      href="/biodescodificacion"
      class:list={[
        'block px-3 py-2 rounded-lg text-base font-medium transition-colors',
        currentPath.startsWith('/biodescodificacion') ? 'text-[#779DD1] font-semibold bg-slate-100 dark:bg-[#0A1226]' : 'text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-[#0A1226] hover:text-[#779DD1]'
      ]}
    >
      Biodescodificación (Catálogo)
    </a>
    <a
      href="/#ciudades"
      class="block px-3 py-2 rounded-lg text-base font-medium text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-[#0A1226] hover:text-[#779DD1] transition-colors"
    >
      Ciudades & Cobertura
    </a>
    <!-- Botón Destacado Sobre Nosotros en Menú Móvil -->
    <a
      href="/sobre-nosotros"
      class:list={[
        'flex items-center justify-between px-3.5 py-2.5 rounded-xl text-base font-semibold transition-all border shadow-sm',
        currentPath.startsWith('/sobre-nosotros')
          ? 'bg-[#779DD1] text-[#060A1A] border-[#779DD1] font-bold'
          : 'bg-slate-100 dark:bg-[#0A1226] text-slate-900 dark:text-white border-slate-300 dark:border-slate-700 hover:border-[#779DD1]'
      ]}
    >
      <div class="flex items-center gap-2.5">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Sobre Nosotros (Vivian Velásquez)</span>
      </div>
      <span class="text-xs">&rarr;</span>
    </a>
    <a
      href="https://share.google/otrUm918xRGNHTTkE"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center justify-between px-3 py-2 rounded-lg text-base font-medium text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 hover:bg-emerald-500/20 transition-colors"
    >
      <span>⭐ Opiniones en Google (4.3 / 5.0)</span>
      <span class="text-xs">&rarr;</span>
    </a>
    <!-- Selector Rápido de Idioma Móvil -->
    <div class="flex items-center justify-between px-3.5 py-2 rounded-xl bg-slate-50 dark:bg-[#0A1226] border border-slate-200 dark:border-slate-800 text-xs">
      <span class="text-slate-600 dark:text-slate-400 font-medium">Idioma:</span>
      <div class="flex items-center gap-2">
        <span class="px-2.5 py-1 rounded-md bg-[#779DD1] text-[#060A1A] font-bold">ES</span>
        <a
          href={buildWhatsAppUrl({ location: 'Mobile Nav — English' })}
          class="px-2.5 py-1 rounded-md bg-slate-200 dark:bg-[#0E172F] text-slate-700 dark:text-slate-300 hover:text-white font-medium transition-colors"
        >
          EN
        </a>
      </div>
    </div>
    <div class="pt-2">
      <a
        href={whatsappCtaUrl}
        data-open-quiz="true"
        data-location="mobile-nav"
        data-symptom=""
        class="btn-action-pill-white w-full flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-white text-[#060A1A] font-medium text-sm hover:bg-[#779DD1] hover:text-[#060A1A] transition-all duration-300 shadow-pill-white"
      >
        <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 448 512" aria-hidden="true">
          <path fill="currentColor" d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
        </svg>
        <span>Agendar Sesión por WhatsApp</span>
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-open-icon');
  const closeIcon = document.getElementById('menu-close-icon');

  if (btn && menu && openIcon && closeIcon) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      openIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });
  }

  // Alternador de Idioma (Desktop y Móvil)
  const langBtnDesktop = document.getElementById('lang-btn-desktop');
  const langMenuDesktop = document.getElementById('lang-menu-desktop');
  const langBtnMobile = document.getElementById('lang-btn-mobile');
  const langMenuMobile = document.getElementById('lang-menu-mobile');

  if (langBtnDesktop && langMenuDesktop) {
    langBtnDesktop.addEventListener('click', (e) => {
      e.stopPropagation();
      const isHidden = langMenuDesktop.classList.contains('hidden');
      langMenuDesktop.classList.toggle('hidden');
      langBtnDesktop.setAttribute('aria-expanded', String(isHidden));
      if (langMenuMobile) langMenuMobile.classList.add('hidden');
    });
  }

  if (langBtnMobile && langMenuMobile) {
    langBtnMobile.addEventListener('click', (e) => {
      e.stopPropagation();
      const isHidden = langMenuMobile.classList.contains('hidden');
      langMenuMobile.classList.toggle('hidden');
      langBtnMobile.setAttribute('aria-expanded', String(isHidden));
      if (langMenuDesktop) langMenuDesktop.classList.add('hidden');
    });
  }

  // Cerrar menús de idioma al hacer clic fuera
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    if (!target) return;
    if (langMenuDesktop && !langMenuDesktop.contains(target) && !langBtnDesktop?.contains(target)) {
      langMenuDesktop.classList.add('hidden');
      langBtnDesktop?.setAttribute('aria-expanded', 'false');
    }
    if (langMenuMobile && !langMenuMobile.contains(target) && !langBtnMobile?.contains(target)) {
      langMenuMobile.classList.add('hidden');
      langBtnMobile?.setAttribute('aria-expanded', 'false');
    }
  });

  // Alternador de Tema (Modo Claro / Modo Oscuro)
  const themeToggles = document.querySelectorAll('.theme-toggle-btn');
  const updateThemeUI = (isDark: boolean) => {
    document.querySelectorAll('.theme-sun-icon').forEach((el) => {
      el.classList.toggle('hidden', !isDark);
    });
    document.querySelectorAll('.theme-moon-icon').forEach((el) => {
      el.classList.toggle('hidden', isDark);
    });
  };

  const initialDark = document.documentElement.classList.contains('dark');
  updateThemeUI(initialDark);

  themeToggles.forEach((tBtn) => {
    tBtn.addEventListener('click', () => {
      const currentlyDark = document.documentElement.classList.contains('dark');
      if (currentlyDark) {
        document.documentElement.classList.remove('dark');
        document.documentElement.classList.add('light');
        try {
          localStorage.setItem('theme_preference', 'light');
          localStorage.setItem('theme', 'light');
        } catch (e) {}
        updateThemeUI(false);
      } else {
        document.documentElement.classList.add('dark');
        document.documentElement.classList.remove('light');
        try {
          localStorage.setItem('theme_preference', 'dark');
          localStorage.setItem('theme', 'dark');
        } catch (e) {}
        updateThemeUI(true);
      }
    });
  });
</script>
