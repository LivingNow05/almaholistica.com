          class="lang-option-btn lang-pill-btn lang-pill-en flex items-center justify-between px-3.5 py-2.5 rounded-xl border text-left font-medium text-xs bg-white dark:bg-[#0E172F] text-slate-800 dark:text-slate-200 border-slate-200 dark:border-slate-700 transition-all hover:border-[#779DD1] min-h-[44px]"
        >
