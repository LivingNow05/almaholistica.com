---
/**
 * src/components/StickyMobileBar.astro
 * Barra de acción inferior fija para dispositivos móviles (md:hidden)
 * Proporciona acceso ergonómico directo a WhatsApp y activación del WhatsAppQuizModal.
 */
import { buildWhatsAppUrl } from '../config/site';

export interface Props {
  symptom?: string;
  city?: string;
  location?: string;
}

const {
  symptom,
  city,
  location = 'Barra Fija Móvil'
} = Astro.props;

const directWhatsAppUrl = buildWhatsAppUrl({
  symptom,
  location: city ? `Móvil ${city}` : location
});
---

<aside
  data-sticky-mobile-bar="true"
  aria-label="Acciones rápidas de contacto y evaluación móvil"
  class="fixed bottom-0 inset-x-0 z-40 md:hidden bg-[#0A1226]/95 border-t border-slate-800 p-3 shadow-2xl backdrop-blur-sm print:hidden"
>
  <div class="max-w-md mx-auto flex items-center justify-between gap-2.5">
    <!-- Botón WhatsApp Directo con Icono Oficial wa.me -->
    <a
      href={directWhatsAppUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Consultar directamente por WhatsApp"
      class="flex items-center justify-center gap-1.5 px-3.5 py-2.5 rounded-full bg-[#0E172F] hover:bg-[#1E293B] border border-slate-700 text-slate-200 hover:text-white text-xs font-sans font-semibold transition-all shrink-0 active:scale-95"
    >
      <svg
        class="w-4 h-4 fill-[#25D366] text-[#25D366] shrink-0"
        viewBox="0 0 448 512"
        width="16"
        height="16"
        aria-hidden="true"
      >
        <path
          fill="currentColor"
          d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"
        />
      </svg>
      <span>WhatsApp</span>
    </a>

    <!-- Botón Primario: Iniciar Evaluación (Dispara WhatsAppQuizModal) -->
    <button
      type="button"
      data-open-quiz="true"
      data-location="sticky-mobile-bar"
      data-symptom={symptom || ''}
      data-city={city || ''}
      class="flex-1 flex items-center justify-center gap-2 px-4 py-2.5 rounded-full bg-[#25D366] hover:bg-[#20ba5a] text-[#060A1A] text-xs sm:text-sm font-sans font-extrabold shadow-lg shadow-emerald-900/30 transition-all active:scale-[0.98] cursor-pointer"
    >
      <span class="w-2 h-2 rounded-full bg-[#060A1A] animate-pulse" aria-hidden="true"></span>
      <span>Iniciar Evaluación</span>
      <span aria-hidden="true">&rarr;</span>
    </button>
  </div>
</aside>
