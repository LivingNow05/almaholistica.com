---
/**
 * src/components/StickyMobileBar.astro — Barra Inferior Fija de Conversión en Móvil
 *
 * Muestra un acceso directo y discreto para contactar por WhatsApp o abrir el Quiz
 * en dispositivos móviles (< 768px), optimizando la tasa de conversión sin obstruir la lectura.
 *
 * Cumplimiento Estricto de Reglas Técnicas:
 * - 100% Sólido Mate (bg-[#0A1226], border-[#1E293B], superficies opacas).
 * - Cero colores prohibidos (sin amarillos #f59e0b).
 * - Accesibilidad táctil superior a 48px de altura y padding safe-area.
 */
import { buildWhatsAppUrl } from '../config/site';

const mobileWhatsAppUrl = buildWhatsAppUrl({
  location: 'Barra Inferior Móvil Global'
});
---

<aside
  class="fixed bottom-0 inset-x-0 z-40 md:hidden bg-[#0A1226] border-t border-[#1E293B] px-4 py-2.5 shadow-2xl safe-area-bottom"
  aria-label="Acceso rápido a consulta por WhatsApp"
>
  <div class="max-w-md mx-auto flex items-center justify-between gap-3">
    <!-- Indicador de disponibilidad en tiempo real -->
    <div class="flex items-center gap-2 min-w-0">
      <span class="relative flex h-2.5 w-2.5 shrink-0" aria-hidden="true">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
      </span>
      <div class="flex flex-col min-w-0">
        <span class="text-xs font-semibold text-white truncate">Terapeutas en línea</span>
        <span class="text-[10px] text-slate-400 truncate">Sesiones 1 a 1 por videollamada</span>
      </div>
    </div>

    <!-- Botón CTA directo -->
    <a
      href={mobileWhatsAppUrl}
      data-open-quiz="true"
      data-location="sticky-mobile-bar"
      data-symptom=""
      class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-full bg-white text-[#060A1A] font-bold text-xs hover:bg-[#38BDF8] transition-colors shrink-0 shadow-sm"
    >
      <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
        <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.23 8.23 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.39-1.72-.14-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.49-.4-.42-.56-.43h-.47c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.77 2.7 4.29 3.78.6.26 1.07.41 1.43.53.6.19 1.15.16 1.58.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.18-.47-.31"/>
      </svg>
      <span>Consultar</span>
    </a>
  </div>
</aside>
