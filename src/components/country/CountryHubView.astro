              &darr;
            </span>
          </summary>
          <div class="mt-4 pt-4 border-t border-[#1E293B] text-sm sm:text-base text-slate-300 font-sans leading-relaxed">
            {faq.respuesta}
          </div>
        </details>
      ))}
    </div>

  </div>
</section>

