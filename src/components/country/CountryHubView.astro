    </div>

    <!-- Lista de Acordeones Sólidos Mates -->
    <div class="space-y-4">
      {country.faqs.map((faq, index) => (
        <details class="group bg-[#0A1226] border border-[#1E293B] rounded-[1.75rem] p-6 transition-all duration-300">
          <summary class="cursor-pointer font-sans font-bold text-base sm:text-lg text-white flex justify-between items-center list-none outline-none select-none">
            <span class="pr-4">{faq.pregunta}</span>
