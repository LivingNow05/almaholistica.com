      <div>
        <div class="inline-flex items-center gap-2 text-xs font-sans font-semibold tracking-wider text-[#38BDF8] uppercase mb-2">
          <span class="w-2 h-2 rounded-full bg-[#38BDF8]"></span>
          <span>DIRECTORIO HIPERLOCAL // {country.pais.toUpperCase()}</span>
        </div>
        <h2 class="font-sans font-bold text-2xl sm:text-3xl text-white uppercase tracking-tight">
          Ciudades con Cobertura y Atención Online en {country.pais}
        </h2>
      </div>
      <span class="text-xs font-sans text-slate-400 uppercase tracking-wider">
        {cities.length} localidades disponibles
      </span>
    </div>

    <!-- Retícula de Ciudades -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5">
      {cities.map((city) => (
        <a
          href={`/${city.slug}/`}
          class="group bg-[#0A1226] border border-[#1E293B] hover:border-[#38BDF8]/60 rounded-[1.75rem] p-6 transition-all duration-300 hover:-translate-y-1 block"
        >
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-sans font-semibold text-slate-400 group-hover:text-[#38BDF8] transition-colors">
              {country.pais}
            </span>
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          </div>
          <span class="block font-sans font-bold text-lg text-white group-hover:text-[#38BDF8] transition-colors mb-2">
            {city.nombre}
          </span>
          <div class="flex items-center justify-between text-xs font-sans text-slate-400">
            <span>Online 1 a 1</span>
            <span class="text-slate-300 font-mono font-medium">{city.precio}</span>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>

<!-- ========================================================================= -->
<!-- 6. ACORDEÓN DE PREGUNTAS FRECUENTES (FAQS CON SCHEMA FAQPAGE)              -->
<!-- ========================================================================= -->
<section class="w-full bg-[#060A1A] py-20 lg:py-28 border-b border-[#1E293B]">
  <div class="max-w-4xl mx-auto px-6 lg:px-12">
    
    <div class="text-center mb-16">
      <div class="inline-flex items-center gap-2 text-xs font-sans font-semibold tracking-wider text-[#38BDF8] uppercase mb-4">
        <span class="w-2 h-2 rounded-full bg-[#38BDF8]"></span>
        <span>PREGUNTAS FRECUENTES // RESOLUCIÓN CLÍNICA</span>
      </div>
      <h2 class="font-sans font-extrabold text-3xl sm:text-4xl uppercase tracking-tight text-white">
