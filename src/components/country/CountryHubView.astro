---
/**
 * src/components/country/CountryHubView.astro
 * Vista Editorial Swiss Bio-Tech de Alta Gama para los Hubs de País (Silos Geográficos).
 * Proyecto: Alma Holística (almaholistica.com)
 *
 * Cumple con R1, R2, R3, R4:
 * - 7 secciones estructuradas con rigor clínico y datos E-E-A-T localizados.
 * - Estilo Sólido Mate (#060A1A, #0A1226, #0E172F, #1E293B, #38BDF8).
 * - Superficies 100% opacas, sin efectos de desenfoque, sin amarillo ni dorado.
 * - Cero CLS con dimensiones explícitas en todos los medios.
 */

import type { CountryData } from '../../types/country';
import { SITE_CONFIG, buildWhatsAppUrl } from '../../config/site';

export interface Props {
  country: CountryData;
}

const { country } = Astro.props;

const specialistInitials = country.especialistaAsignado.nombre
  .replace(/^(Lic\.|Dr\.|Dra\.)\s*/i, '')
  .split(' ')
  .filter(Boolean)
  .slice(0, 2)
  .map((w: string) => w[0])
  .join('') || 'AH';

const whatsappUrl = buildWhatsAppUrl({
  location: `Hub de País — ${country.pais}`
});

const cities = country.ciudades || [];
---

<!-- ========================================================================= -->
<!-- 1. HERO GEOGRÁFICO Y CONVERSIÓN SWISS BIO-TECH                            -->
<!-- ========================================================================= -->
<section class="relative w-full bg-[#060A1A] pt-8 pb-16 sm:pt-12 sm:pb-24 border-b border-[#1E293B]">
  <div class="max-w-7xl mx-auto px-6 lg:px-12 relative z-10">
    
    <!-- Migas de Pan Semánticas Jerárquicas -->
    <nav class="flex items-center gap-2 text-xs font-sans tracking-wide text-slate-400 mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#38BDF8] transition-colors">INICIO</a>
      <span class="text-slate-600">/</span>
      <a href="/#paises" class="hover:text-[#38BDF8] transition-colors">PAÍSES</a>
      <span class="text-slate-600">/</span>
      <span class="text-[#38BDF8] font-semibold uppercase">{country.pais}</span>
    </nav>

    <!-- Retícula Principal: Contenido a la Izquierda y Medios a la Derecha -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center min-h-[40vh] mb-12">
      
      <!-- Columna Izquierda: Copy Hero y Acciones -->
      <div class="lg:col-span-7 xl:col-span-8 flex flex-col items-start text-left">
        
        <!-- Badge Localizado con Pulsante Esmeralda -->
        <div class="inline-flex items-center gap-2.5 text-xs font-sans font-semibold tracking-wider text-[#38BDF8] uppercase mb-6">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>SESIONES ONLINE EN VIVO • {country.pais.toUpperCase()}</span>
        </div>

        <!-- Título Monumental H1 -->
        <h1 class="font-sans font-extrabold text-3xl sm:text-5xl lg:text-6xl tracking-tight leading-[1.12] text-white max-w-4xl mb-6">
          {country.h1}
        </h1>

        <!-- Subtítulo de Autoridad Clínica -->
        <p class="text-base sm:text-lg lg:text-xl text-slate-200 font-sans font-medium max-w-3xl leading-relaxed mb-4">
          Acompañamiento clínico individual para decodificar el conflicto biológico inconsciente de tus dolencias físicas sin salir de casa.
        </p>

        <!-- Definición Clínica Resumida -->
        <p class="text-sm sm:text-base text-slate-300 font-sans max-w-3xl leading-relaxed mb-8">
          {country.definicionClinica}
        </p>

        <!-- Indicadores Operativos Clave (3 Tarjetas Sólidas con Bordes de Acento) -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8 w-full max-w-3xl">
          <div class="bg-[#0A1226] border border-[#1E293B] rounded-2xl p-5 border-l-4 border-l-[#38BDF8] flex flex-col justify-center">
            <span class="text-xs font-sans font-medium uppercase tracking-wider text-slate-400 mb-1">Inversión Estimada</span>
            <span class="text-lg sm:text-xl font-bold font-sans text-white">{country.rangoPrecio}</span>
            <span class="text-xs text-slate-400 mt-1 font-sans">Moneda oficial: {country.moneda}</span>
          </div>
          <div class="bg-[#0A1226] border border-[#1E293B] rounded-2xl p-5 border-l-4 border-l-emerald-400 flex flex-col justify-center">
            <span class="text-xs font-sans font-medium uppercase tracking-wider text-slate-400 mb-1">Modalidad</span>
            <span class="text-lg sm:text-xl font-bold font-sans text-white">100% Online en Directo</span>
            <span class="text-xs text-slate-400 mt-1 font-sans">Google Meet / Zoom cifrado</span>
          </div>
          <div class="bg-[#0A1226] border border-[#1E293B] rounded-2xl p-5 border-l-4 border-l-[#38BDF8] flex flex-col justify-center">
            <span class="text-xs font-sans font-medium uppercase tracking-wider text-slate-400 mb-1">Huso Horario</span>
            <span class="text-lg sm:text-xl font-bold font-sans text-white">{country.husoHorario}</span>
            <span class="text-xs text-slate-400 mt-1 font-sans">Atención adaptada a tu país</span>
          </div>
        </div>

        <!-- Botones de Acción: White Pill CTA + Botón WhatsApp Oficial -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-5 w-full sm:w-auto">
          <a
            href={whatsappUrl}
            data-open-quiz="true"
            data-country={country.pais}
            class="btn-action-pill-white inline-flex items-center justify-center gap-3 px-8 py-4 rounded-full bg-white text-[#060A1A] font-bold text-sm font-sans hover:bg-[#38BDF8] hover:text-[#060A1A] transition-all duration-500 shadow-pill-white focus:outline-none focus:ring-2 focus:ring-[#38BDF8] text-center"
          >
            <span>Iniciar Evaluación en {country.pais}</span>
            <svg class="w-4 h-4 shrink-0 text-[#060A1A]" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a
            href={whatsappUrl}
            data-open-quiz="true"
            data-country={country.pais}
            class="btn-whatsapp-primary inline-flex items-center justify-center gap-3 px-8 py-4 rounded-full text-base font-sans font-bold shadow-lg focus:outline-none"
          >
            <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 448 512" width="20" height="20" aria-hidden="true">
              <path fill="currentColor" d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
            </svg>
            <span>Consultar por WhatsApp</span>
          </a>

          <a
            href="/biodescodificacion/"
            class="group inline-flex items-center gap-2 text-sm text-slate-300 hover:text-[#38BDF8] font-sans font-semibold py-3.5 px-4 transition-colors"
          >
            <span>[CATÁLOGO DE SÍNTOMAS]</span>
            <span class="group-hover:translate-x-1.5 transition-transform duration-300" aria-hidden="true">&rarr;</span>
          </a>
        </div>

      </div>

      <!-- Columna Derecha: Imagen Circular con Marco Rígido (CLS = 0) -->
      <div class="lg:col-span-5 xl:col-span-4 flex flex-col justify-center items-center relative">
        <div class="relative w-64 h-64 sm:w-80 sm:h-80 lg:w-96 lg:h-96 rounded-full p-2 bg-[#0A1226] border-2 border-[#1E293B] shadow-2xl flex items-center justify-center shrink-0">
          <div class="w-full h-full rounded-full overflow-hidden border border-slate-700 bg-[#060A1A] relative flex items-center justify-center">
            <img
              src="/images/sesion-online-en-casa.webp"
              alt={`Sesión online de biodescodificación en ${country.pais}`}
              width="1024"
              height="1024"
              loading="eager"
              decoding="async"
              class="w-full h-full object-cover rounded-full transform hover:scale-105 transition-transform duration-700 ease-out"
            />
          </div>
          <!-- Badge Inferior -->
          <div class="absolute -bottom-2 bg-[#0A1226] border border-slate-700 rounded-full px-4 py-1.5 shadow-lg flex items-center gap-2 text-xs font-sans text-slate-300">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Atención Directa en {country.pais}</span>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

<!-- ========================================================================= -->
<!-- 2. ENFOQUE CLÍNICO Y E-E-A-T METODOLÓGICO                                  -->
<!-- ========================================================================= -->
<section class="w-full bg-[#060A1A] py-20 lg:py-28 border-b border-[#1E293B]">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 text-xs font-sans font-semibold tracking-wider text-[#38BDF8] uppercase mb-4">
        <span class="w-2 h-2 rounded-full bg-[#38BDF8]"></span>
        <span>METODOLOGÍA CLÍNICA // DESCODIFICACIÓN BIOLÓGICA</span>
      </div>
      <h2 class="font-sans font-extrabold text-3xl sm:text-4xl lg:text-5xl uppercase tracking-tight text-white">
        Comprensión Biológica y Desactivación del Conflicto en {country.pais}
      </h2>
      <p class="text-base text-slate-300 mt-4 leading-relaxed font-sans max-w-2xl mx-auto">
        La enfermedad no es un error de la naturaleza ni un fallo arbitrario del organismo: es una respuesta de adaptación biológica ante impactos emocionales no resueltos.
      </p>
    </div>

    <!-- Tríptico Metodológico Sólido Mate -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Pilar 1: El Bioshock (DHS) -->
      <div class="bg-[#0E172F] border border-[#1E293B] rounded-[2rem] p-8 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-[#0A1226] border border-[#1E293B] flex items-center justify-center text-[#38BDF8] font-bold text-xl mb-6">
            01
          </div>
          <h3 class="font-sans font-bold text-xl text-white mb-3">
            El Choque Biológico Inesperado (DHS)
          </h3>
          <p class="text-sm text-slate-300 leading-relaxed font-sans">
            Todo síntoma físico tiene como punto de partida un impacto psicoemocional vivido en soledad, de manera imprevista y sin solución inmediata exteriorizable. El cerebro activa un programa especial de supervivencia para proteger la vida del individuo.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-[#1E293B] text-xs text-slate-400 font-sans">
          Fase Simpaticotónica Activa
        </div>
      </div>

      <!-- Pilar 2: Correlación Neurovegetativa -->
      <div class="bg-[#0E172F] border border-[#1E293B] rounded-[2rem] p-8 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-[#0A1226] border border-[#1E293B] flex items-center justify-center text-emerald-400 font-bold text-xl mb-6">
            02
          </div>
          <h3 class="font-sans font-bold text-xl text-white mb-3">
            Correlación Cerebro-Órgano
          </h3>
          <p class="text-sm text-slate-300 leading-relaxed font-sans">
            Cada capa embrionaria (endodermo, mesodermo y ectodermo) responde a necesidades biológicas precisas: respiración, digestión, protección, estructura ósea o contacto social. Identificamos con exactitud el relé cerebral y el órgano afectado.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-[#1E293B] text-xs text-slate-400 font-sans">
          Mapeo Embriológico y Psicosomático
        </div>
      </div>

      <!-- Pilar 3: Desactivación y Vagotonía -->
      <div class="bg-[#0E172F] border border-[#1E293B] rounded-[2rem] p-8 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-[#0A1226] border border-[#1E293B] flex items-center justify-center text-[#38BDF8] font-bold text-xl mb-6">
            03
          </div>
          <h3 class="font-sans font-bold text-xl text-white mb-3">
            Reprogramación y Fase de Curación
          </h3>
          <p class="text-sm text-slate-300 leading-relaxed font-sans">
            Mediante protocolos guiados en vivo, permitimos que el consultante exteriorice la emoción retenida, desactive la alarma biológica y facilite la entrada en vagotonía (fase de reparación tisular y desinflamación natural del cuerpo).
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-[#1E293B] text-xs text-slate-400 font-sans">
          Autorregulación Homeostática
        </div>
      </div>

    </div>

  </div>
</section>

<!-- ========================================================================= -->
<!-- 3. ESPECIALISTA SENIOR ASIGNADO (E-E-A-T Y AVAL CIENTÍFICO)                -->
<!-- ========================================================================= -->
<section class="w-full bg-[#060A1A] py-20 lg:py-28 border-b border-[#1E293B]">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    
    <div class="bg-[#0A1226] border border-[#1E293B] rounded-[2.5rem] p-10 lg:p-14">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        
        <!-- Ficha del Especialista: Avatar y Titulaciones -->
        <div class="lg:col-span-4 flex flex-col items-center text-center lg:items-start lg:text-left">
          <div class="w-28 h-28 rounded-full bg-[#0E172F] border-2 border-[#38BDF8] flex items-center justify-center text-[#38BDF8] font-sans font-extrabold text-3xl mb-6 shadow-inner">
            {specialistInitials}
          </div>
          <span class="text-xs font-sans font-bold uppercase tracking-wider text-[#38BDF8] mb-1">
            Especialista Senior Asignado
          </span>
          <h3 class="text-2xl font-bold font-sans text-white mb-2">
            {country.especialistaAsignado.nombre}
          </h3>
          <p class="text-sm text-slate-300 font-sans mb-3">
            {country.especialistaAsignado.cargo}
          </p>
          <span class="inline-block px-3 py-1 rounded-full text-xs font-mono font-medium bg-[#0E172F] text-slate-300 border border-[#1E293B] mb-4">
            {country.especialistaAsignado.registro}
          </span>
          <p class="text-xs text-slate-400 font-sans leading-relaxed">
            {country.especialistaAsignado.experiencia}
          </p>
        </div>

        <!-- Formación y Aval Científico -->
        <div class="lg:col-span-8 space-y-6 border-t lg:border-t-0 lg:border-l border-[#1E293B] pt-8 lg:pt-0 lg:pl-10">
          <div>
            <h4 class="text-xs font-sans font-bold uppercase tracking-wider text-slate-400 mb-2">
              Formación y Credenciales Clínicas
            </h4>
            <p class="text-sm text-slate-200 font-sans leading-relaxed">
              {country.especialistaAsignado.formacion}
            </p>
          </div>

          <div>
            <h4 class="text-xs font-sans font-bold uppercase tracking-wider text-slate-400 mb-2">
              Aval Científico y Marco Teórico
            </h4>
            <p class="text-sm text-slate-300 font-sans leading-relaxed">
              {country.especialistaAsignado.avalCientifico}
            </p>
          </div>

          <!-- 4 Pilares Fundacionales -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 border-t border-[#1E293B]">
            <div class="p-3 bg-[#0E172F] border border-[#1E293B] rounded-xl text-center">
              <span class="text-xs font-bold text-white block">Psiconeuroinmunología</span>
              <span class="text-[11px] text-slate-400">Eje mente-cuerpo</span>
            </div>
            <div class="p-3 bg-[#0E172F] border border-[#1E293B] rounded-xl text-center">
              <span class="text-xs font-bold text-white block">Dr. Ryke Hamer</span>
              <span class="text-[11px] text-slate-400">Leyes biológicas</span>
            </div>
            <div class="p-3 bg-[#0E172F] border border-[#1E293B] rounded-xl text-center">
              <span class="text-xs font-bold text-white block">Christian Flèche</span>
              <span class="text-[11px] text-slate-400">Descodificación</span>
            </div>
            <div class="p-3 bg-[#0E172F] border border-[#1E293B] rounded-xl text-center">
              <span class="text-xs font-bold text-white block">Dr. Bruce Lipton</span>
              <span class="text-[11px] text-slate-400">Epigenética</span>
            </div>
          </div>

          <!-- Botón de Agendamiento con Especialista -->
          <div class="pt-2">
            <a
              href={whatsappUrl}
              data-open-quiz="true"
              data-country={country.pais}
              class="inline-flex items-center gap-2 text-xs font-sans font-bold uppercase tracking-wider text-[#38BDF8] hover:text-white transition-colors"
            >
              <span>Consultar disponibilidad con {country.especialistaAsignado.nombre} &rarr;</span>
            </a>
          </div>

        </div>

      </div>
    </div>

  </div>
</section>

<!-- ========================================================================= -->
<!-- 4. INFORMACIÓN OPERATIVA, TARIFAS Y PASARELAS LOCALES                      -->
<!-- ========================================================================= -->
<section class="w-full bg-[#060A1A] py-20 lg:py-28 border-b border-[#1E293B]">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 text-xs font-sans font-semibold tracking-wider text-[#38BDF8] uppercase mb-4">
        <span class="w-2 h-2 rounded-full bg-[#38BDF8]"></span>
        <span>INFORMACIÓN OPERATIVA // COBERTURA NACIONAL</span>
      </div>
      <h2 class="font-sans font-extrabold text-3xl sm:text-4xl lg:text-5xl uppercase tracking-tight text-white">
        Tarifas Oficiales, Husos Horarios y Medios de Pago en {country.pais}
      </h2>
      <p class="text-base text-slate-300 mt-4 leading-relaxed font-sans max-w-2xl mx-auto">
        Transparencia operativa total para consultantes en {country.pais}. Sin comisiones ocultas y con métodos de pago locales habituales.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- Especificaciones de la Consulta -->
      <div class="lg:col-span-6 bg-[#0A1226] border border-[#1E293B] rounded-[2rem] p-8 space-y-6">
        <h3 class="font-sans font-bold text-xl text-white border-b border-[#1E293B] pb-4">
          Detalles de la Consulta Online
        </h3>
        
        <ul class="space-y-4 text-sm font-sans">
          <li class="flex items-center justify-between pb-3 border-b border-[#1E293B]/60">
            <span class="text-slate-400">Moneda Oficial Habilitada:</span>
            <span class="font-bold text-white">{country.moneda}</span>
          </li>
          <li class="flex items-center justify-between pb-3 border-b border-[#1E293B]/60">
            <span class="text-slate-400">Rango de Inversión por Sesión:</span>
            <span class="font-bold text-[#38BDF8]">{country.rangoPrecio}</span>
          </li>
          <li class="flex items-center justify-between pb-3 border-b border-[#1E293B]/60">
            <span class="text-slate-400">Huso Horario de Atención:</span>
            <span class="font-bold text-white">{country.husoHorario}</span>
          </li>
          <li class="flex items-center justify-between pb-3 border-b border-[#1E293B]/60">
            <span class="text-slate-400">Duración de la Intervención:</span>
            <span class="font-bold text-white">60 a 75 minutos en directo</span>
          </li>
          <li class="flex items-center justify-between">
            <span class="text-slate-400">Canal de Conexión:</span>
            <span class="font-bold text-emerald-400">Google Meet / Zoom cifrado</span>
          </li>
        </ul>
      </div>

      <!-- Pasarelas y Marco Regulatorio Local -->
      <div class="lg:col-span-6 bg-[#0A1226] border border-[#1E293B] rounded-[2rem] p-8 space-y-6">
        <h3 class="font-sans font-bold text-xl text-white border-b border-[#1E293B] pb-4">
          Pasarelas de Pago y Respaldo Local
        </h3>

        <div>
          <span class="text-xs font-sans font-bold uppercase tracking-wider text-slate-400 mb-3 block">
            Medios de Pago Habilitados en {country.pais}:
          </span>
          <div class="flex flex-wrap gap-2">
            {country.pasarelasPago.map((pasarela) => (
              <span class="px-3.5 py-1.5 rounded-xl bg-[#0E172F] border border-[#1E293B] text-xs font-sans font-semibold text-slate-200">
                {pasarela}
              </span>
            ))}
          </div>
        </div>

        <div>
          <span class="text-xs font-sans font-bold uppercase tracking-wider text-slate-400 mb-2 block">
            Marco Regulatorio Sanitario YMYL:
          </span>
          <p class="text-xs text-slate-300 font-sans leading-relaxed bg-[#0E172F] p-4 rounded-xl border border-[#1E293B]">
            {country.marcoRegulatorio}
          </p>
        </div>

      </div>

    </div>

  </div>
</section>

<!-- ========================================================================= -->
<!-- 5. RETÍCULA DE CIUDADES SUBORDINADAS (ARQUITECTURA SILO DESCENDENTE)       -->
<!-- ========================================================================= -->
<section class="w-full bg-[#060A1A] py-20 lg:py-28 border-b border-[#1E293B]">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    
