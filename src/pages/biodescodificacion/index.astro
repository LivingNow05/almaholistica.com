---
/**
 * src/pages/biodescodificacion/index.astro — Catálogo General de Dolencias de Biodescodificación
 *
 * Arquitectura: Astro 5 SSG, Tailwind CSS y TypeScript.
 * Estilo Visual: Sólido mate estricto (#060A1A, #0A1226, #0E172F, #1E293B, #779DD1, #779DD1).
 * Cero desenfoque de fondo, sin transparencias ni brillos artificiales.
 * Anti-CLS: Contención estricta de anchos, responsive de 320px a 4K.
 *
 * Características integradas:
 * - Catálogo completo de las 45 patologías estructuradas con sentido biológico y conflicto inconsciente.
 * - Clasificación por los 7 sistemas biológicos (Digestivo, Osteoarticular, Nervioso, Respiratorio, etc.).
 * - Buscador interactivo en vivo y filtro por pestañas de sistema corporal (vanilla JS sin dependencias externas).
 * - Enlaces directos a cada ruta temática /biodescodificacion/[slug].
 * - Botones CTA conectados al Quiz Modal con data-open-quiz="true" y data-symptom pre-cargado.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildWhatsAppUrl } from '../../config/site';
import { getDolencias, getBiologicalBorderClass, getBiologicalBadgeClass } from '../../lib/dolencias';
import type { BodilySystem, DolenciaData } from '../../types/dolencia';

// Carga memoizada de las 45 dolencias del catálogo
const dolencias = getDolencias();

// Los 7 sistemas corporales validados
const sistemas: (BodilySystem | string)[] = [
  'Digestivo',
  'Nervioso / Emocional',
  'Osteoarticular',
  'Dermatológico',
  'Respiratorio',
  'Endocrino / Metabólico',
  'Inmunológico / Circulatorio'
];

// Agrupación por sistema para el renderizado estructurado
const dolenciasPorSistema: Record<string, DolenciaData[]> = {};
for (const sis of sistemas) {
  dolenciasPorSistema[sis] = dolencias.filter((d) => d.sistema === sis);
}

// URL de WhatsApp para consultas directas del catálogo
const catalogoWhatsAppUrl = buildWhatsAppUrl({
  location: 'Catálogo General de Biodescodificación'
});
---

<BaseLayout
  title="Catálogo de Biodescodificación: 45 Dolencias y Conflictos Emocionales | Alma Holística"
  description="Diccionario y catálogo completo de las 45 patologías físicas y emocionales en biodescodificación. Conoce el sentido biológico de supervivencia y el conflicto emocional de cada síntoma."
  canonical="https://almaholistica.com/biodescodificacion/"
>
  <!-- ========================================================================= -->
  <!-- 1. BREADCRUMBS Y CABECERA DEL CATÁLOGO                                    -->
  <!-- ========================================================================= -->
  <section class="w-full bg-[#060A1A] pt-8 pb-12 sm:pt-12 sm:pb-16 border-b border-[#1E293B]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Navegación de Migas de Pan (Breadcrumbs) -->
      <nav class="flex items-center gap-2 text-xs text-slate-400 mb-8 font-sans" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#779DD1] transition-colors">Inicio</a>
        <span class="text-slate-600">/</span>
        <span class="text-slate-200 font-medium">Biodescodificación</span>
      </nav>

      <div class="max-w-4xl">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#0E172F] border border-[#779DD1] text-[#779DD1] text-xs font-semibold uppercase tracking-wider mb-4">
          <span>Diccionario Bioemocional & Sentido Biológico</span>
        </div>

        <h1 class="font-sans font-extrabold text-3xl sm:text-5xl tracking-tight text-white leading-tight mb-4">
          Catálogo Completo de <span class="text-[#779DD1]">Biodescodificación</span>
        </h1>

        <!-- Guía Rápida de 30 Segundos para Principiantes -->
        <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="p-4 rounded-xl bg-[#0A1226] border border-slate-800">
            <span class="text-xs font-bold text-[#779DD1] uppercase tracking-wider block mb-1">01 // Tu cuerpo habla</span>
            <p class="text-xs text-slate-300 leading-relaxed">Todo dolor o molestia recurrente es la respuesta del cuerpo a una vivencia emocional no procesada.</p>
          </div>
          <div class="p-4 rounded-xl bg-[#0A1226] border border-slate-800">
            <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider block mb-1">02 // El sentido biológico</span>
            <p class="text-xs text-slate-300 leading-relaxed">Cada órgano expresa una vivencia: el estómago retiene lo indigesto, la espalda carga peso ajeno.</p>
          </div>
          <div class="p-4 rounded-xl bg-[#0A1226] border border-slate-800">
            <span class="text-xs font-bold text-[#F97316] uppercase tracking-wider block mb-1">03 // Desactivación 1 a 1</span>
            <p class="text-xs text-slate-300 leading-relaxed">En una sesión privada online rastreamos la causa raíz para liberar la tensión de tu sistema nervioso.</p>
          </div>
        </div>
      </div>

      <!-- Barra de Búsqueda y Filtro de Sistemas Corporales -->
      <div class="mt-10 space-y-6">
        
        <!-- Input de Búsqueda Reactivo -->
        <div class="relative max-w-xl">
          <input
            type="text"
            id="symptom-filter-input"
            placeholder="Buscar por síntoma o conflicto (ej: gastritis, ciática, tiroides, migraña...)"
            class="w-full px-5 py-4 pl-12 rounded-xl bg-[#0A1226] border border-[#1E293B] focus:border-[#779DD1] text-slate-100 placeholder-slate-500 text-sm font-sans outline-none transition-colors"
          />
          <svg class="w-5 h-5 text-slate-400 absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="20" height="20">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>

        <!-- Pestañas de Filtro por Sistema Corporal -->
        <div class="flex flex-wrap gap-2 pt-2" id="system-filter-tabs">
          <button
            type="button"
            data-system="all"
            class="filter-tab active px-4 py-2 rounded-lg text-xs font-semibold font-sans bg-[#779DD1] text-[#060A1A] border border-[#779DD1] transition-colors cursor-pointer"
          >
            Todos ({dolencias.length})
          </button>

          {sistemas.map((sis) => {
            const count = dolenciasPorSistema[sis]?.length || 0;
            return (
              <button
                type="button"
                data-system={sis}
                class="filter-tab px-4 py-2 rounded-lg text-xs font-semibold font-sans bg-[#0A1226] hover:bg-[#0E172F] text-slate-300 hover:text-white border border-[#1E293B] hover:border-[#1E3A5F] transition-colors cursor-pointer"
              >
                {sis} ({count})
              </button>
            );
          })}
        </div>

      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 2. CATÁLOGO COMPLETO DE 45 DOLENCIAS (GRID RESPONSIVE SÓLIDO MATE)         -->
  <!-- ========================================================================= -->
  <section class="w-full bg-[#060A1A] py-16 sm:py-20 border-b border-[#1E293B]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Contador de Resultados Dinámico -->
      <div class="flex items-center justify-between mb-8 pb-4 border-b border-[#1E293B]">
        <div class="text-xs text-slate-400 font-sans">
          Mostrando <span id="visible-count" class="font-bold text-white">{dolencias.length}</span> de {dolencias.length} dolencias analizadas
        </div>
        <div class="text-xs text-[#779DD1] font-sans font-medium">
          7 Sistemas Biológicos Cubiertos
        </div>
      </div>

      <!-- Cuadrícula Principal de Tarjetas (Responsive Grid) -->
      <div id="catalog-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {dolencias.map((item) => (
          <article
            class={`dolencia-item-card ${getBiologicalBorderClass(item.sistema)} bg-[#0A1226] border border-[#1E293B] rounded-2xl p-6 flex flex-col justify-between hover:border-[#779DD1] transition-colors`}
            data-sistema={item.sistema}
            data-search-text={`${item.nombre} ${item.sistema} ${item.conflictoEmocional} ${item.sentidoBiologico}`.toLowerCase()}
          >
            <div>
              <!-- Cabecera de la Tarjeta: Sistema -->
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class={`bio-badge ${getBiologicalBadgeClass(item.sistema)} inline-flex items-center text-xs font-semibold tracking-wider uppercase`}>
                  {item.sistema}
                </span>
                <span class="text-xs text-slate-500 font-sans font-medium uppercase">
                  Biodescodificación
                </span>
              </div>

              <!-- Título de la Patología con Enlace a la Ficha Temática -->
              <h2 class="font-sans font-bold text-xl text-white mb-3">
                <a href={`/biodescodificacion/${item.slug}`} class="hover:text-[#779DD1] transition-colors">
                  {item.nombre}
                </a>
              </h2>

              <!-- Resumen del Conflicto Biológico Inconsciente -->
              <div class="space-y-2.5 mb-5 font-sans">
                <div>
                  <span class="block text-xs uppercase tracking-wider font-semibold text-slate-400 mb-1">
                    Conflicto Emocional:
                  </span>
                  <p class="text-sm text-slate-300 leading-relaxed line-clamp-3">
                    {item.conflictoEmocional}
                  </p>
                </div>

                <div>
                  <span class="block text-xs uppercase tracking-wider font-semibold text-[#779DD1] mb-1">
                    Sentido Biológico:
                  </span>
                  <p class="text-sm text-slate-400 leading-relaxed line-clamp-2">
                    {item.sentidoBiologico}
                  </p>
                </div>
              </div>
            </div>

            <!-- Pie de la Tarjeta: Enlace a Detalle y Botón de Conversión Interceptado -->
            <div class="pt-4 border-t border-[#1E293B] flex items-center justify-between gap-3">
              <a
                href={`/biodescodificacion/${item.slug}`}
                class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-300 hover:text-[#779DD1] transition-colors"
                aria-label={`Ver sentido biológico completo de ${item.nombre}`}
              >
                <span>Ficha completa</span>
                <span aria-hidden="true">&rarr;</span>
              </a>

              <button
                type="button"
                data-open-quiz="true"
                data-symptom={item.nombre}
                data-location="catalogo-grid-button"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#0E172F] hover:bg-[#779DD1] border border-[#1E3A5F] hover:border-[#779DD1] text-[#779DD1] hover:text-[#060A1A] font-bold text-xs transition-colors cursor-pointer"
              >
                <span>Evaluar</span>
              </button>
            </div>
          </article>
        ))}
      </div>

      <!-- Mensaje cuando no hay resultados en el filtro -->
      <div id="no-results-msg" class="hidden text-center py-16 bg-[#0A1226] border border-[#1E293B] rounded-2xl p-8 mt-6">
        <p class="font-serif text-lg font-normal text-white mb-2">
          No se encontraron dolencias con el término buscado
        </p>
        <p class="text-xs text-slate-400 font-sans max-w-md mx-auto mb-6">
          Puedes intentar con un término más general o consultar directamente a un terapeuta a través de nuestro Quiz de Evaluación.
        </p>
        <button
          type="button"
          data-open-quiz="true"
          data-location="catalogo-no-results"
          data-symptom=""
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#779DD1] hover:bg-[#7DD3FC] text-[#060A1A] font-bold text-xs uppercase tracking-wider transition-colors cursor-pointer"
        >
          <span>Evaluar tu Síntoma en el Quiz</span>
          <span aria-hidden="true">&rarr;</span>
        </button>
      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 3. FUNDAMENTO METODOLÓGICO DE LOS 7 SISTEMAS                              -->
  <!-- ========================================================================= -->
  <section class="w-full bg-[#060A1A] py-16 sm:py-20 border-b border-[#1E293B]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="text-xs font-semibold uppercase tracking-widest text-[#779DD1] block mb-2">
          Mapa Somático
        </span>
        <h2 class="font-sans font-bold text-2xl sm:text-4xl text-white tracking-wide">
          Cómo se proyectan las emociones en cada sistema
        </h2>
        <p class="text-sm sm:text-base text-slate-400 mt-4 leading-relaxed font-sans">
          Cada órgano y tejido deriva de una capa embrionaria específica con memorias arquetípicas de supervivencia.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <div class="bg-[#0A1226] border border-[#1E293B] rounded-2xl p-6 space-y-3">
          <div class="flex items-center gap-3">
            <span class="w-2.5 h-2.5 rounded-full bg-[#779DD1]"></span>
            <h3 class="font-sans font-bold text-lg text-white">Sistema Digestivo</h3>
          </div>
          <p class="text-sm text-slate-300 leading-relaxed font-sans">
            Conflictos de <em>"bocado"</em>: aquello que no podemos tragar, tolerar, asimilar o eliminar (injusticias familiares, decepciones viscerales o carencia material).
          </p>
        </div>

        <div class="bg-[#0A1226] border border-[#1E293B] rounded-2xl p-6 space-y-3">
          <div class="flex items-center gap-3">
            <span class="w-2.5 h-2.5 rounded-full bg-[#779DD1]"></span>
            <h3 class="font-sans font-bold text-lg text-white">Sistema Osteoarticular</h3>
          </div>
          <p class="text-sm text-slate-300 leading-relaxed font-sans">
            Conflictos de <em>desvalorización profunda</em>, falta de apoyo del clan, sensación de no ser suficientemente apto o llevar un peso excesivo sobre los hombros.
          </p>
        </div>

        <div class="bg-[#0A1226] border border-[#1E293B] rounded-2xl p-6 space-y-3">
          <div class="flex items-center gap-3">
            <span class="w-2.5 h-2.5 rounded-full bg-[#779DD1]"></span>
            <h3 class="font-sans font-bold text-lg text-white">Sistema Nervioso / Emocional</h3>
          </div>
          <p class="text-sm text-slate-300 leading-relaxed font-sans">
            Conflictos de <em>alerta continua</em>, hipervigilancia ante peligros imaginados o reales, miedo al futuro y necesidad rígida de mantener el control mental.
          </p>
        </div>

        <div class="bg-[#0A1226] border border-[#1E293B] rounded-2xl p-6 space-y-3">
          <div class="flex items-center gap-3">
            <span class="w-2.5 h-2.5 rounded-full bg-[#779DD1]"></span>
            <h3 class="font-sans font-bold text-lg text-white">Sistema Dermatológico</h3>
          </div>
          <p class="text-sm text-slate-300 leading-relaxed font-sans">
            Conflictos de <em>separación y contacto</em>: pérdida involuntaria de cercanía física o rechazo a un contacto no deseado que vulnera los límites personales.
          </p>
        </div>

        <div class="bg-[#0A1226] border border-[#1E293B] rounded-2xl p-6 space-y-3">
          <div class="flex items-center gap-3">
            <span class="w-2.5 h-2.5 rounded-full bg-[#779DD1]"></span>
            <h3 class="font-sans font-bold text-lg text-white">Sistema Respiratorio</h3>
          </div>
          <p class="text-sm text-slate-300 leading-relaxed font-sans">
            Conflictos de <em>miedo a la muerte o asfixia vital</em>: invasión del propio territorio, disputas en el hogar o sensación de que no hay suficiente espacio para respirar.
          </p>
        </div>

        <div class="bg-[#0A1226] border border-[#1E293B] rounded-2xl p-6 space-y-3">
          <div class="flex items-center gap-3">
            <span class="w-2.5 h-2.5 rounded-full bg-[#779DD1]"></span>
            <h3 class="font-sans font-bold text-lg text-white">Endocrino & Circulatorio</h3>
          </div>
          <p class="text-sm text-slate-300 leading-relaxed font-sans">
            Conflictos con <em>el tiempo</em> (urgencia o necesidad de frenar el tiempo en tiroides) y conflictos con <em>los lazos de sangre</em> y la cohesión de la familia.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 4. CTA GLOBAL CON MODAL DE EVALUACIÓN                                     -->
  <!-- ========================================================================= -->
  <section class="w-full bg-[#060A1A] py-16 sm:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-[#0E172F] border border-[#1E3A5F] rounded-3xl p-8 sm:p-12 text-center space-y-6">
        
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#0A1226] border border-[#779DD1] text-[#779DD1] text-xs font-semibold uppercase tracking-wider">
          Sesiones Online 1 a 1
        </span>

        <h2 class="font-sans font-bold text-2xl sm:text-4xl text-white tracking-wide">
          ¿Deseas decodificar tu síntoma con un terapeuta experto?
        </h2>

        <p class="text-sm sm:text-base text-slate-300 max-w-2xl mx-auto font-sans leading-relaxed">
          Inicia nuestro cuestionario interactivo de 4 pasos para identificar el patrón de evolución de tu dolencia. Te orientaremos en tu idioma y según las necesidades de tu caso.
        </p>

        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={catalogoWhatsAppUrl}
            data-open-quiz="true"
            data-location="catalogo-final-cta"
            data-symptom=""
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl bg-[#779DD1] hover:bg-[#7DD3FC] text-[#060A1A] font-bold text-base transition-colors"
          >
            <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 448 512" width="20" height="20" aria-hidden="true">
              <path fill="currentColor" d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
            </svg>
            <span>Iniciar Evaluación Gratuita por WhatsApp</span>
          </a>
        </div>

        <p class="text-xs text-slate-400 font-sans max-w-xl mx-auto mt-4 leading-normal">
          * Recordatorio terapéutico: la biodescodificación complementa tu autoconocimiento y no reemplaza tratamientos médicos ni farmacológicos.
        </p>

      </div>
    </div>
  </section>

  <!-- Script ligero de filtrado interactivo por texto y por sistema corporal (cero CLS) -->
  <script>
    const searchInput = document.getElementById('symptom-filter-input') as HTMLInputElement | null;
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
    const cards = document.querySelectorAll<HTMLElement>('.dolencia-item-card');
    const visibleCount = document.getElementById('visible-count');
    const noResultsMsg = document.getElementById('no-results-msg');

    let currentSystem = 'all';
    let searchQuery = '';

    function applyFilters() {
      let count = 0;

      cards.forEach((card) => {
        const cardSystem = card.getAttribute('data-sistema') || '';
        const cardSearchText = card.getAttribute('data-search-text') || '';

        const matchesSystem = currentSystem === 'all' || cardSystem === currentSystem;
        const matchesQuery = !searchQuery || cardSearchText.includes(searchQuery);

        if (matchesSystem && matchesQuery) {
          card.style.display = 'flex';
          count++;
        } else {
          card.style.display = 'none';
        }
      });

      if (visibleCount) {
        visibleCount.textContent = String(count);
      }

      if (noResultsMsg) {
        if (count === 0) {
          noResultsMsg.classList.remove('hidden');
        } else {
          noResultsMsg.classList.add('hidden');
        }
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        searchQuery = target.value.toLowerCase().trim();
        applyFilters();
      });
    }

    tabButtons.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabButtons.forEach((t) => {
          t.classList.remove('bg-[#779DD1]', 'text-[#060A1A]', 'border-[#779DD1]');
          t.classList.add('bg-[#0A1226]', 'text-slate-300', 'border-[#1E293B]');
        });

        tab.classList.remove('bg-[#0A1226]', 'text-slate-300', 'border-[#1E293B]');
        tab.classList.add('bg-[#779DD1]', 'text-[#060A1A]', 'border-[#779DD1]');

        currentSystem = tab.getAttribute('data-system') || 'all';
        applyFilters();
      });
    });
  </script>
</BaseLayout>
