---
/**
 * src/pages/biodescodificacion/[slug].astro — Ruta Dinámica SSG para Dolencias Físicas y Emocionales
 * Alma Holística (almaholistica.com)
 *
 * Genera estáticamente las 45 páginas temáticas de biodescodificación por síntoma.
 * Estilo visual estricto: Sólido Mate (#060A1A, #0A1226, #0E172F, #1E293B, #779DD1, #779DD1).
 * Cero transparencias, cero brillos artificiales, cero desenfoques.
 * Cumple con R1, R2, R3, R4 y la suite de pruebas E2E (Features 16, Cruce 2, Journey B).
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDolencias } from '../../lib/dolencias';
import type { DolenciaData, DolenciaStaticPath } from '../../types/dolencia';
import { SITE_CONFIG, buildWhatsAppUrl } from '../../config/site';
import {
  buildMedicalWebPageSchema,
  buildFAQSchema,
  buildBreadcrumbSchema,
} from '../../lib/schema';

export async function getStaticPaths(): Promise<DolenciaStaticPath[]> {
  const dolencias = getDolencias();
  return dolencias.map((dolencia) => ({
    params: { slug: dolencia.slug },
    props: { dolencia },
  }));
}

export interface Props {
  dolencia: DolenciaData;
}

const { dolencia } = Astro.props;

// Extracción tipada estricta de las propiedades de la dolencia
const nombre = dolencia.nombre;
const sistema = dolencia.sistema;
const conflictoEmocional = dolencia.conflictoEmocional;
const sentidoBiologico = dolencia.sentidoBiologico;
const reprogramacion = dolencia.reprogramacion;
const preguntasReflexion = dolencia.preguntasReflexion || [];
const faqs = dolencia.faqs || [];
const ganchoAgendamiento = dolencia.ganchoAgendamiento;

// Metadatos SEO y URL Canónica oficial con trailing slash (conforme a astro.config.mjs)
const pageTitle = `Biodescodificación de ${nombre} | Conflicto Emocional y Sanación | ${SITE_CONFIG.name}`;
const pageDescription = `Descubre el conflicto emocional inconsciente y sentido biológico de ${nombre}. Pautas de reprogramación mental y agenda tu sesión online de diagnóstico.`;
const canonicalUrl = `https://almaholistica.com/biodescodificacion/${dolencia.slug}/`;

// Schemas JSON-LD Estructurados (MedicalWebPage + FAQPage + BreadcrumbList) conforme a Cruce 2
const medicalSchema = buildMedicalWebPageSchema(dolencia, canonicalUrl);
const faqSchema = buildFAQSchema(faqs);
const breadcrumbSchema = buildBreadcrumbSchema([
  {
    name: 'Inicio',
    url: 'https://almaholistica.com/',
  },
  {
    name: 'Biodescodificación',
    url: 'https://almaholistica.com/biodescodificacion/',
  },
  {
    name: nombre,
    url: canonicalUrl,
  },
]);

// Generación de URL de WhatsApp estructurada para progressive enhancement
const fallbackWhatsAppUrl = buildWhatsAppUrl({
  symptom: nombre,
});
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
>
  <Fragment slot="schema">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(medicalSchema)} />
    {faqSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <article class="w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
    <!-- Migas de pan solemnes -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-slate-400 mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#779DD1] transition-colors">Inicio</a>
      <span class="text-slate-600">/</span>
      <a href="/biodescodificacion" class="hover:text-[#779DD1] transition-colors">Biodescodificación</a>
      <span class="text-slate-600">/</span>
      <span class="text-[#779DD1] font-medium truncate max-w-[200px] sm:max-w-none">{nombre}</span>
    </nav>

    <!-- HERO SECTION DE DOLENCIA -->
    <header class="card-matte-elevated p-6 sm:p-10 md:p-12 mb-10 relative overflow-hidden">
      <div class="max-w-3xl">
        <!-- Badge de Sistema Biológico Técnico con Pulsación -->
        <div class="inline-flex items-center gap-2.5 text-xs font-sans font-bold tracking-wider text-[#38BDF8] uppercase mb-4">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>SISTEMA {sistema.toUpperCase()} • BIODESCODIFICACIÓN</span>
        </div>

        <!-- H1 Dinámico Requerido por T1.16.2 / T1.16.3 -->
        <h1 class="font-sans font-extrabold text-3xl sm:text-5xl lg:text-6xl tracking-tight uppercase leading-[1.08] text-white mt-2 mb-4">
          Biodescodificación de {nombre}
        </h1>

        <p class="text-base sm:text-lg text-slate-300 font-sans leading-relaxed mb-8">
          Comprende el significado biológico inconsciente de este síntoma, desactiva la respuesta adaptativa de alarma de tu cuerpo y recupera tu bienestar a través de una sesión online 1 a 1.
        </p>

        <!-- CTAs Principales con Interceptación Global de WhatsApp Quiz Modal (data-symptom) -->
        <div class="flex flex-wrap items-center gap-4">
          <a
            href={fallbackWhatsAppUrl}
            class="btn-whatsapp-primary inline-flex items-center justify-center gap-3 px-8 py-4 rounded-full text-base font-sans font-bold shadow-lg focus:outline-none focus:ring-2 focus:ring-[#25D366]"
            data-open-quiz="true"
            data-symptom={nombre}
          >
            <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.23 8.23 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.39-1.72-.14-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.49-.4-.42-.56-.43h-.47c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.77 2.7 4.29 3.78.6.26 1.07.41 1.43.53.6.19 1.15.16 1.58.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.18-.47-.31"/>
            </svg>
            <span>Evaluar mi Síntoma por WhatsApp</span>
          </a>

          <a
            href="#en-palabras-simples"
            class="btn-action-secondary text-sm font-semibold"
          >
            <span>¿Qué significa en palabras simples?</span>
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 9l-7 7-7-7" />
            </svg>
          </a>
        </div>
      </div>
    </header>

    <!-- MÓDULO DIDÁCTICO "EN PALABRAS SIMPLES: ¿QUÉ ESTÁS VIVIENDO?" -->
    <section id="en-palabras-simples" class="mb-10" aria-label="En palabras simples">
      <div class="mb-6">
        <div class="flex items-center gap-2 mb-2">
          <span class="w-2 h-2 rounded-full bg-[#38BDF8]"></span>
          <span class="text-xs uppercase tracking-widest text-[#38BDF8] font-semibold">Explicación Clara y Cercana</span>
        </div>
        <h2 class="heading-solemn text-2xl sm:text-3xl font-normal text-slate-100">
          En Palabras Simples: ¿Qué intenta decirte tu cuerpo?
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <!-- Tarjeta 1: La Vivencia Diaria -->
        <div class="card-matte-elevated p-6 flex flex-col justify-between border-t-2 border-t-[#F97316]">
          <div>
            <span class="text-xs font-sans uppercase tracking-wider text-[#F97316] font-bold block mb-2">01 // La Emoción Oculta</span>
            <h3 class="text-base font-bold text-white mb-2">¿Cómo se siente en tu día a día?</h3>
            <p class="text-sm text-slate-300 leading-relaxed">
              Suele relacionarse con situaciones de impotencia, silencios prolongados o sobreexigencia donde te costó poner límites o expresar lo que sentías.
            </p>
          </div>
        </div>

        <!-- Tarjeta 2: La Reacción Biológica -->
        <div class="card-matte-elevated p-6 flex flex-col justify-between border-t-2 border-t-[#38BDF8]">
          <div>
            <span class="text-xs font-sans uppercase tracking-wider text-[#38BDF8] font-bold block mb-2">02 // La Respuesta Orgánica</span>
            <h3 class="text-base font-bold text-white mb-2">¿Por qué reacciona el cuerpo?</h3>
            <p class="text-sm text-slate-300 leading-relaxed">
              Tu biología no se equivoca: activa una alerta temporal en este tejido para amortiguar el impacto del estrés que tu mente no pudo resolver.
            </p>
          </div>
        </div>

        <!-- Tarjeta 3: La Clave de Liberación -->
        <div class="card-matte-elevated p-6 flex flex-col justify-between border-t-2 border-t-emerald-400">
          <div>
            <span class="text-xs font-sans uppercase tracking-wider text-emerald-400 font-bold block mb-2">03 // El Camino de Alivio</span>
            <h3 class="text-base font-bold text-white mb-2">¿Cómo empezar a sanarlo?</h3>
            <p class="text-sm text-slate-300 leading-relaxed">
              Al hacer consciente la emoción original y resignificarla en consulta 1 a 1, el sistema nervioso suelta la alarma y el cuerpo vuelve a su estado de equilibrio.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- TERMÓMETRO BIOLÓGICO DIDÁCTICO -->
    <section class="card-matte p-6 sm:p-8 mb-10 border border-slate-800" aria-label="Termómetro Biológico">
      <div class="flex items-center justify-between flex-wrap gap-4 mb-4">
        <div>
          <span class="text-xs uppercase tracking-wider text-slate-400 font-bold block mb-1">Fases Biológicas de tu Dolencia</span>
          <h3 class="text-lg sm:text-xl font-bold text-white">¿En qué etapa se encuentra tu síntoma?</h3>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="p-4 rounded-xl bg-[#0A1226] border border-[#F97316]/40">
          <span class="text-xs font-sans font-bold text-[#F97316] uppercase block mb-1">🔴 Fase 1: Estrés Activo</span>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            La mente le da vueltas al problema, hay tensión muscular o insomnio. El cuerpo mantiene encendido el programa de adaptación.
          </p>
        </div>
        <div class="p-4 rounded-xl bg-[#0A1226] border border-[#38BDF8]/40">
          <span class="text-xs font-sans font-bold text-[#38BDF8] uppercase block mb-1">🔵 Fase 2: Fase de Reparación</span>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Tras verbalizar o calmar el conflicto, aparece la inflamación o cansancio reparador. La biología trabaja para regenerar el tejido.
          </p>
        </div>
      </div>
    </section>

    <!-- SECCIÓN 1: EL CONFLICTO EMOCIONAL INCONSCIENTE (T1.16.3) -->
    <section id="conflicto" class="card-matte-elevated p-6 sm:p-8 md:p-10 mb-10" aria-labelledby="conflicto-heading">
      <div class="flex items-center gap-2 mb-3">
        <span class="w-2 h-2 rounded-full bg-[#779DD1]"></span>
        <span class="text-xs uppercase tracking-widest text-[#779DD1] font-semibold">Origen Psicoemocional</span>
      </div>
      <h2 id="conflicto-heading" class="heading-solemn text-2xl sm:text-3xl font-normal mb-6 text-slate-100">
        El Conflicto Emocional Inconsciente
      </h2>

      <!-- Bloque destacado con la cita central del conflicto -->
      <div class="p-6 bg-[#0A1226] border-l-4 border-[#779DD1] rounded-r-xl mb-6">
        <p class="text-lg sm:text-xl text-slate-100 font-medium leading-relaxed italic">
          "{conflictoEmocional}"
        </p>
      </div>

      <div class="text-slate-300 leading-relaxed space-y-4 text-base sm:text-lg">
        <p>
          En biodescodificación, entendemos que este síntoma no surge por casualidad ni por una falla aleatoria del cuerpo. El organismo almacena vivencias no resueltas de estrés agudo, donde la persona experimentó impotencia, falta de expresión o contradicción interna.
        </p>
        <p>
          Cuando la mente consciente no logra gestionar o manifestar verbalmente el impacto emocional, el sistema nervioso traslada la carga al tejido orgánico correspondiente para brindar una solución biológica de emergencia.
        </p>
      </div>
    </section>

    <!-- SECCIÓN 2: EL SENTIDO BIOLÓGICO DE SUPERVIVENCIA (T1.16.3) -->
    <section class="card-matte p-6 sm:p-8 md:p-10 mb-10" aria-labelledby="sentido-heading">
      <div class="flex items-center gap-2 mb-3">
        <span class="w-2 h-2 rounded-full bg-[#779DD1]"></span>
        <span class="text-xs uppercase tracking-widest text-[#779DD1] font-semibold">Fisiología y Adaptación</span>
      </div>
      <h2 id="sentido-heading" class="heading-solemn text-2xl sm:text-3xl font-normal mb-6 text-slate-100">
        El Sentido Biológico de Supervivencia
      </h2>

      <div class="p-6 bg-[#0E172F] border border-[#1E3A5F] rounded-xl mb-6">
        <p class="text-base sm:text-lg text-slate-200 leading-relaxed font-normal">
          {sentidoBiologico}
        </p>
      </div>

      <p class="text-sm sm:text-base text-slate-400 leading-relaxed">
        Cada órgano responde a un código de supervivencia evolutiva. Al comprender para qué actúa la biología con esta alteración celular o funcional, dejamos de luchar contra el síntoma y comenzamos a escuchar el mensaje profundo que busca restablecer el equilibrio.
      </p>
    </section>

    <!-- SECCIÓN 3: PAUTA DE REPROGRAMACIÓN Y DECRETO SANADOR -->
    <section class="card-matte-elevated border border-[#779DD1] p-8 sm:p-10 md:p-12 mb-10 text-center rounded-xl relative overflow-hidden" aria-labelledby="reprogramacion-heading">
      <div class="max-w-2xl mx-auto">
        <span class="badge-gold mb-4">Integración y Liberación</span>
        <h2 id="reprogramacion-heading" class="heading-solemn text-2xl sm:text-3xl font-normal mb-6 text-slate-100">
          Pauta de Reprogramación Bioemocional
        </h2>

        <blockquote class="font-serif text-xl sm:text-2xl text-[#779DD1] italic my-6 leading-relaxed font-normal">
          "{reprogramacion}"
        </blockquote>

        <p class="text-sm sm:text-base text-slate-300 leading-relaxed mt-6">
          La reprogramación no es una simple repetición mecánica de palabras: es un acto consciente de resignificación donde autorizas a tu sistema nervioso a desactivar el estado de alarma permanente.
        </p>
      </div>
    </section>

    <!-- SECCIÓN 4: PREGUNTAS DE INTROSPECCIÓN Y REFLEXIÓN (T1.16.4) -->
    {preguntasReflexion.length > 0 && (
      <section class="card-matte p-6 sm:p-8 md:p-10 mb-10" aria-labelledby="reflexion-heading">
        <div class="flex items-center gap-2 mb-3">
          <span class="w-2 h-2 rounded-full bg-[#779DD1]"></span>
          <span class="text-xs uppercase tracking-widest text-[#779DD1] font-semibold">Autoindagación Consciente</span>
        </div>
        <h2 id="reflexion-heading" class="heading-solemn text-2xl sm:text-3xl font-normal mb-3 text-slate-100">
          Preguntas de Reflexión para tu Proceso
        </h2>
        <p class="text-sm sm:text-base text-slate-400 mb-8">
          Busca un espacio de tranquilidad y reflexiona con total sinceridad sobre estas interrogantes vinculadas a tu síntoma:
        </p>

        <div class="space-y-4">
          {preguntasReflexion.map((pregunta, index) => (
            <div class="card-matte-elevated p-5 sm:p-6 flex items-start gap-4">
              <span class="w-8 h-8 rounded-full bg-[#0A1226] border border-[#779DD1] text-[#779DD1] font-bold text-sm flex items-center justify-center flex-shrink-0 mt-0.5">
                {index + 1}
              </span>
              <p class="text-base sm:text-lg text-slate-200 font-medium leading-relaxed">
                {pregunta}
              </p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- SECCIÓN 5: GANCHO DE AGENDAMIENTO Y CTA INTERMEDIO -->
    {ganchoAgendamiento && (
      <section class="card-matte-elevated border-l-4 border-[#779DD1] p-6 sm:p-8 md:p-10 mb-10">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="max-w-2xl">
            <span class="text-xs uppercase tracking-wider text-[#779DD1] font-semibold mb-2 block">
              Acompañamiento Terapéutico Profesional
            </span>
            <p class="text-lg sm:text-xl font-semibold text-slate-100 leading-snug">
              {ganchoAgendamiento}
            </p>
          </div>
          <a
            href={fallbackWhatsAppUrl}
            class="btn-action-primary text-base font-bold flex-shrink-0"
            data-open-quiz="true"
            data-symptom={nombre}
          >
            <span>Descodificar Mi Caso</span>
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </section>
    )}

    <!-- CÓMO ES UNA SESIÓN ONLINE PARA ESTE SÍNTOMA -->
    <section class="mb-12" aria-labelledby="sesion-pasos-heading">
      <div class="mb-6">
        <div class="flex items-center gap-2 mb-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span class="text-xs uppercase tracking-widest text-emerald-400 font-semibold">Proceso Claro y Seguro</span>
        </div>
        <h2 id="sesion-pasos-heading" class="heading-solemn text-2xl sm:text-3xl font-normal text-slate-100">
          ¿Cómo es una Sesión Online para Biodescodificar tu {nombre}?
        </h2>
        <p class="text-sm sm:text-base text-slate-400 mt-2">
          Un espacio profesional, 100% privado y sin juicios, enfocado en llegar al fondo de tu síntoma:
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="card-matte p-5 rounded-2xl">
          <span class="w-8 h-8 rounded-full bg-[#0E172F] border border-slate-700 text-[#38BDF8] font-bold text-xs flex items-center justify-center mb-3">01</span>
          <h3 class="text-sm font-bold text-white mb-1">Contacto Inicial</h3>
          <p class="text-xs text-slate-300 leading-relaxed">Nos cuentas brevemente sobre tu {nombre} y cuánto tiempo llevas experimentándolo.</p>
        </div>
        <div class="card-matte p-5 rounded-2xl">
          <span class="w-8 h-8 rounded-full bg-[#0E172F] border border-slate-700 text-[#38BDF8] font-bold text-xs flex items-center justify-center mb-3">02</span>
          <h3 class="text-sm font-bold text-white mb-1">Detección de la Raíz</h3>
          <p class="text-xs text-slate-300 leading-relaxed">En videollamada 1 a 1 de 60-75 min, rastreamos el evento o vivencia que detonó la señal.</p>
        </div>
        <div class="card-matte p-5 rounded-2xl">
          <span class="w-8 h-8 rounded-full bg-[#0E172F] border border-slate-700 text-[#38BDF8] font-bold text-xs flex items-center justify-center mb-3">03</span>
          <h3 class="text-sm font-bold text-white mb-1">Liberación Emocional</h3>
          <p class="text-xs text-slate-300 leading-relaxed">Guiamos técnicas para resignificar la vivencia y desactivar el estado de alerta del cuerpo.</p>
        </div>
        <div class="card-matte p-5 rounded-2xl">
          <span class="w-8 h-8 rounded-full bg-[#0E172F] border border-slate-700 text-[#38BDF8] font-bold text-xs flex items-center justify-center mb-3">04</span>
          <h3 class="text-sm font-bold text-white mb-1">Integración y Calma</h3>
          <p class="text-xs text-slate-300 leading-relaxed">Te llevas pautas prácticas para mantener la tranquilidad y apoyar la regeneración natural.</p>
        </div>
      </div>
    </section>

    <!-- SECCIÓN 6: PREGUNTAS FRECUENTES (FAQS) (T1.16.4) -->
    {faqs.length > 0 && (
      <section class="mb-12" aria-labelledby="faqs-heading">
        <div class="flex items-center gap-2 mb-3">
          <span class="w-2 h-2 rounded-full bg-[#779DD1]"></span>
          <span class="text-xs uppercase tracking-widest text-[#779DD1] font-semibold">Claridad y Fundamentos</span>
        </div>
        <h2 id="faqs-heading" class="heading-solemn text-2xl sm:text-3xl font-normal mb-6 text-slate-100">
          Preguntas Frecuentes sobre la Biodescodificación de {nombre}
        </h2>

        <div class="space-y-4">
          {faqs.map((faq) => (
            <details class="card-matte p-5 sm:p-6 group cursor-pointer">
              <summary class="flex justify-between items-center text-base sm:text-lg font-semibold text-slate-100 list-none">
                <span class="pr-4">{faq.pregunta}</span>
                <span class="text-[#779DD1] text-xl transition-transform group-open:rotate-45 font-sans font-bold flex-shrink-0">+</span>
              </summary>
              <p class="mt-4 text-sm sm:text-base text-slate-300 leading-relaxed border-t border-[#1E293B] pt-4">
                {faq.respuesta}
              </p>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- SECCIÓN 7: DESCARGO DE RESPONSABILIDAD MÉDICA -->
    <aside class="card-matte p-6 mb-12 border-l-4 border-slate-600" aria-label="Aviso Médico">
      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 text-slate-400 flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10" />
          <line x1="12" y1="8" x2="12" y2="12" />
