---
import ProposalLayout from '../../layouts/ProposalLayout.astro';
import ProposalDock from '../../components/proposals/ProposalDock.astro';

const proposals = [
  {
    number: '01',
    title: 'Calma editorial',
    description: 'Cálida, íntima y sofisticada. Prioriza la confianza emocional y una lectura serena.',
    href: '/propuestas/calma-editorial',
    className: 'editorial',
    tags: ['Marfil', 'Salvia', 'Terracota'],
  },
  {
    number: '02',
    title: 'Naturaleza viva',
    description: 'Inmersiva, sensorial y contemporánea. Convierte la conexión mente–cuerpo en una experiencia.',
    href: '/propuestas/naturaleza-viva',
    className: 'organic',
    tags: ['Bosque', 'Lima suave', 'Orgánica'],
  },
  {
    number: '03',
    title: 'Claridad clínica',
    description: 'Luminosa, directa y confiable. Ordena la información con un sistema visual modular.',
    href: '/propuestas/claridad-clinica',
    className: 'clinical',
    tags: ['Blanco', 'Cobalto', 'Lavanda'],
  },
];
---

<ProposalLayout
  title="Tres propuestas visuales — Alma Holística"
  description="Índice comparativo de tres direcciones visuales para Alma Holística."
  themeColor="#111111"
>
  <div class="proposal-page gallery">
    <header class="gallery__header">
      <a href="/" class="brand" aria-label="Volver al sitio actual">
        <img src="/logo-mariposa-con-fondo-completo.svg" alt="" width="42" height="42" />
        <span>Alma Holística</span>
      </a>
      <a class="current-site" href="/">
        Ver diseño actual
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
    </header>

    <main>
      <section class="intro">
        <div class="intro__meta">
          <span>Exploración visual</span>
          <span>08.10.2026</span>
        </div>
        <h1>Tres maneras de hacer que<br /><em>el cuerpo se sienta escuchado.</em></h1>
        <p>
          El mismo propósito de marca, interpretado desde tres sensibilidades diferentes.
          Entra en cada concepto para recorrer una portada completa y responsive.
        </p>
      </section>

      <section class="proposal-grid" aria-label="Propuestas disponibles">
        {proposals.map((proposal) => (
          <a href={proposal.href} class={`proposal-card proposal-card--${proposal.className}`}>
            <div class="proposal-card__top">
              <span>{proposal.number}</span>
              <span>Explorar</span>
            </div>
            <div class="proposal-card__visual" aria-hidden="true">
              {proposal.className === 'editorial' && (
                <>
                  <span class="editorial__word">sentir</span>
                  <span class="editorial__circle"></span>
                  <span class="editorial__rule"></span>
                </>
              )}
              {proposal.className === 'organic' && (
                <>
                  <span class="organic__orb organic__orb--one"></span>
                  <span class="organic__orb organic__orb--two"></span>
                  <span class="organic__word">ALMA</span>
                </>
              )}
              {proposal.className === 'clinical' && (
                <>
                  <span class="clinical__tile clinical__tile--one"></span>
                  <span class="clinical__tile clinical__tile--two"></span>
                  <span class="clinical__plus">+</span>
                  <span class="clinical__word">CLARIDAD</span>
                </>
              )}
            </div>
            <div class="proposal-card__copy">
              <h2>{proposal.title}</h2>
              <p>{proposal.description}</p>
              <div class="proposal-card__tags">
                {proposal.tags.map((tag) => <span>{tag}</span>)}
              </div>
            </div>
          </a>
        ))}
      </section>
    </main>

    <footer class="gallery__footer">
      <span>Prototipos de dirección de arte</span>
      <span>El contenido final puede combinarse entre propuestas</span>
    </footer>
    <ProposalDock active="overview" />
  </div>
</ProposalLayout>

<style>
  .gallery {
    min-height: 100vh;
    padding: 30px clamp(20px, 4vw, 64px) 100px;
    overflow: hidden;
    color: #f5f2eb;
    background:
      radial-gradient(circle at 8% 0%, rgba(255, 255, 255, 0.08), transparent 28%),
      #111210;
    font-family: 'DM Sans', sans-serif;
  }

  .gallery__header,
  .gallery__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1500px;
    margin: 0 auto;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 11px;
    color: #fff;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
  }

  .brand img {
    width: 38px;
    height: 38px;
    border-radius: 50%;
  }

  .current-site {
    display: flex;
    align-items: center;
    gap: 8px;
    color: rgba(255, 255, 255, 0.66) !important;
    font-size: 13px;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .current-site:hover {
    color: #fff !important;
  }

  .current-site svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }

  main {
    max-width: 1500px;
    margin: 0 auto;
  }

  .intro {
    max-width: 1020px;
    padding: clamp(76px, 10vw, 140px) 0 clamp(56px, 7vw, 96px);
  }

  .intro__meta {
    display: flex;
    gap: 22px;
    margin-bottom: 24px;
    color: #a9aa9f;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .intro h1 {
    margin: 0;
    font-family: 'Newsreader', serif;
    font-size: clamp(3.15rem, 7.5vw, 7.2rem);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 0.89;
  }

  .intro h1 em {
    color: #b8baaf;
    font-weight: 400;
  }

  .intro p {
    max-width: 650px;
    margin: 34px 0 0;
    color: #a9aa9f;
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    line-height: 1.65;
  }

  .proposal-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .proposal-card {
    position: relative;
    display: flex;
    min-height: 630px;
    flex-direction: column;
    overflow: hidden;
    border-radius: 3px;
    color: inherit;
    text-decoration: none;
    transition: transform 350ms cubic-bezier(.2,.7,.2,1);
  }

  .proposal-card:hover {
    transform: translateY(-8px);
  }

  .proposal-card__top {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    padding: 25px 27px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .proposal-card__visual {
    position: relative;
    flex: 1;
    min-height: 320px;
    overflow: hidden;
  }

  .proposal-card__copy {
    position: relative;
    z-index: 2;
    padding: 28px;
  }

  .proposal-card__copy h2 {
    margin: 0 0 10px;
    font-size: clamp(1.55rem, 2.2vw, 2.2rem);
    letter-spacing: -0.035em;
  }

  .proposal-card__copy p {
    min-height: 70px;
    margin: 0;
    opacity: 0.74;
    font-size: 14px;
    line-height: 1.55;
  }

  .proposal-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 20px;
  }

  .proposal-card__tags span {
    padding: 7px 10px;
    border: 1px solid currentColor;
    border-radius: 99px;
    opacity: 0.62;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .proposal-card--editorial {
    color: #173d36;
    background: #f3eee5;
  }

  .editorial__word {
    position: absolute;
    top: 28%;
    left: 9%;
    z-index: 2;
    font: 400 clamp(4rem, 7vw, 7rem)/1 'Newsreader', serif;
    letter-spacing: -0.07em;
  }

  .editorial__circle {
    position: absolute;
    top: 12%;
    right: -8%;
    width: 250px;
    height: 250px;
    border-radius: 50%;
    background: #d99a7d;
  }

  .editorial__rule {
    position: absolute;
    right: 12%;
    bottom: 14%;
    width: 46%;
    height: 1px;
    background: #173d36;
    transform: rotate(-32deg);
    transform-origin: right;
  }

  .proposal-card--organic {
    color: #eaffdd;
    background: #0a2319;
  }

  .proposal-card--organic::after {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(214, 255, 190, 0.15) 0.7px, transparent 0.7px);
    background-size: 8px 8px;
    content: '';
    pointer-events: none;
  }

  .organic__orb {
    position: absolute;
    border-radius: 42% 58% 68% 32% / 46% 42% 58% 54%;
  }

  .organic__orb--one {
    top: 4%;
    left: 2%;
    width: 78%;
    aspect-ratio: 1;
    background: #7ec06d;
    transform: rotate(24deg);
  }

  .organic__orb--two {
    right: -18%;
    bottom: -15%;
    width: 68%;
    aspect-ratio: 1;
    background: #c7ff79;
    mix-blend-mode: screen;
    opacity: 0.48;
  }

  .organic__word {
    position: absolute;
    z-index: 1;
    right: -8px;
    bottom: 10%;
    font: 800 clamp(4.5rem, 8vw, 8rem)/0.8 'Manrope', sans-serif;
    letter-spacing: -0.09em;
  }

  .proposal-card--clinical {
    color: #0b1743;
    background: #eef0ff;
  }

  .clinical__tile {
    position: absolute;
    border-radius: 34px;
  }

  .clinical__tile--one {
    top: 8%;
    left: 8%;
    width: 52%;
    height: 58%;
    background: #3158ff;
  }

  .clinical__tile--two {
    right: 8%;
    bottom: 7%;
    width: 52%;
    height: 52%;
    border: 2px solid #3158ff;
    background: #fff;
  }

  .clinical__plus {
    position: absolute;
    top: 16%;
    left: 20%;
    z-index: 1;
    color: #fff;
    font: 400 5rem/1 'DM Sans', sans-serif;
  }

  .clinical__word {
    position: absolute;
    z-index: 1;
    right: 13%;
    bottom: 21%;
    color: #3158ff;
    font: 800 1rem/1 'Manrope', sans-serif;
    letter-spacing: 0.04em;
    writing-mode: vertical-rl;
  }

  .gallery__footer {
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    color: #7f8178;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 980px) {
    .proposal-grid {
      grid-template-columns: 1fr;
    }

    .proposal-card {
      min-height: 540px;
    }

    .proposal-card__copy p {
      min-height: auto;
    }
  }

  @media (max-width: 620px) {
    .gallery {
      padding-top: 20px;
    }

    .current-site {
      font-size: 0;
    }

    .current-site svg {
      width: 24px;
      height: 24px;
    }

    .intro {
      padding-top: 74px;
    }

    .intro h1 br {
      display: none;
    }

    .proposal-card {
      min-height: 510px;
    }

    .gallery__footer {
      align-items: flex-start;
      gap: 14px;
      flex-direction: column;
    }
  }
</style>
