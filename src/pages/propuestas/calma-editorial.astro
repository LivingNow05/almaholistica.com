---
import ProposalLayout from '../../layouts/ProposalLayout.astro';
import ProposalDock from '../../components/proposals/ProposalDock.astro';
import { buildWhatsAppUrl } from '../../config/site';

const whatsappUrl = buildWhatsAppUrl({ location: 'Propuesta 01 — Calma editorial' });
const symptoms = [
  { title: 'Ansiedad', note: 'Cuando vivir en alerta se vuelve cotidiano', image: '/images/sintoma-estres-ansiedad.webp', href: '/biodescodificacion/ansiedad' },
  { title: 'Gastritis', note: 'Eso que todavía cuesta digerir', image: '/images/sintoma-gastritis-digestivo.webp', href: '/biodescodificacion/gastritis' },
  { title: 'Dolor lumbar', note: 'El peso que el cuerpo intenta sostener', image: '/images/sintoma-espalda-tension.webp', href: '/biodescodificacion/lumbalgia' },
];
---

<ProposalLayout
  title="Calma editorial — Propuesta 01 | Alma Holística"
  description="Una dirección visual cálida, íntima y editorial para Alma Holística."
  themeColor="#f5f0e7"
>
  <div class="proposal-page editorial-page">
    <header class="site-header">
      <a href="/" class="logo" aria-label="Alma Holística, ir al inicio">
        <img src="/logo-mariposa-con-fondo-completo.svg" alt="" width="44" height="44" />
        <span>Alma <em>Holística</em></span>
      </a>
      <nav aria-label="Navegación de la propuesta">
        <a href="#mirada">Nuestra mirada</a>
        <a href="#sintomas">Síntomas</a>
        <a href="#proceso">El proceso</a>
      </nav>
      <a class="header-cta" href={whatsappUrl}>Conversemos</a>
    </header>

    <main>
      <section class="hero" id="mirada">
        <div class="hero__copy">
          <div class="eyebrow"><span></span> Acompañamiento bioemocional online</div>
          <h1>Tu cuerpo habla.<br /><em>Aprendamos a escucharlo.</em></h1>
          <p class="hero__intro">
            Un espacio privado y humano para comprender la raíz emocional de lo que sientes,
            recuperar calma y volver a habitar tu cuerpo con confianza.
          </p>
          <div class="hero__actions">
            <a class="button button--primary" href={whatsappUrl}>
              Explorar mi caso
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
            <a class="text-link" href="#proceso">Conocer el acompañamiento <span>↓</span></a>
          </div>
          <div class="hero__trust">
            <div><strong>1 a 1</strong><span>Sesiones privadas</span></div>
            <div><strong>20+</strong><span>Países atendidos</span></div>
            <div><strong>Online</strong><span>Desde tu espacio</span></div>
          </div>
        </div>

        <div class="hero__visual">
          <div class="hero__image-wrap">
            <img
              src="/images/sesion-online-en-casa.webp"
              alt="Mujer participando en una sesión de acompañamiento online desde casa"
              width="1024"
              height="1024"
            />
          </div>
          <blockquote>
            <span>“</span>
            No se trata de pelear con el síntoma, sino de comprender qué intenta proteger.
          </blockquote>
          <div class="hero__seal" aria-hidden="true">
            <svg viewBox="0 0 100 100">
              <defs><path id="circlePath" d="M 50, 50 m -34, 0 a 34,34 0 1,1 68,0 a 34,34 0 1,1 -68,0" /></defs>
              <text><textPath href="#circlePath">CUERPO · EMOCIÓN · CONCIENCIA · </textPath></text>
            </svg>
            <span>AH</span>
          </div>
        </div>
      </section>

      <section class="symptoms" id="sintomas">
        <div class="section-heading">
          <span class="section-number">01</span>
          <div>
            <p>Empieza por lo que hoy sientes</p>
            <h2>Cada síntoma guarda<br /><em>una historia por comprender.</em></h2>
          </div>
          <a href="/biodescodificacion">Ver las 45 guías <span>↗</span></a>
        </div>

        <div class="symptom-grid">
          {symptoms.map((symptom, index) => (
            <a href={symptom.href} class="symptom-card">
              <div class="symptom-card__image">
                <img src={symptom.image} alt="" width="500" height="500" loading="lazy" />
                <span>0{index + 1}</span>
              </div>
              <div class="symptom-card__copy">
                <h3>{symptom.title}</h3>
                <p>{symptom.note}</p>
                <span class="arrow">↗</span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <section class="belief">
        <div class="belief__label">Nuestra manera de acompañarte</div>
        <p>
          Creemos en un proceso que une <em>conocimiento, sensibilidad y escucha</em>.
          Sin fórmulas rígidas. Sin juicios. A tu ritmo.
        </p>
        <div class="belief__flower" aria-hidden="true">
          <span></span><span></span><span></span><span></span>
        </div>
      </section>

      <section class="process" id="proceso">
        <div class="process__intro">
          <span class="section-number">02</span>
          <p>Un camino claro, sostenido por una conversación profundamente humana.</p>
          <h2>De sentirte en alerta<br />a comprenderte <em>con calma.</em></h2>
        </div>
        <ol class="process__steps">
          <li>
            <span class="step-number">01</span>
            <div><h3>Nos cuentas</h3><p>Una evaluación breve nos ayuda a conocer tu síntoma y el momento que atraviesas.</p></div>
          </li>
          <li>
            <span class="step-number">02</span>
            <div><h3>Conectamos</h3><p>En una sesión privada exploramos los patrones emocionales vinculados a tu historia.</p></div>
          </li>
          <li>
            <span class="step-number">03</span>
            <div><h3>Integramos</h3><p>Te llevas claridad y prácticas sencillas para acompañar tu proceso cotidiano.</p></div>
          </li>
        </ol>
      </section>

      <section class="closing">
        <div class="closing__leaf closing__leaf--left" aria-hidden="true"></div>
        <div class="closing__leaf closing__leaf--right" aria-hidden="true"></div>
        <p>Tu bienestar puede empezar con una pregunta honesta.</p>
        <h2>¿Qué intenta decirte<br /><em>tu cuerpo hoy?</em></h2>
        <a class="button button--light" href={whatsappUrl}>Hacer mi evaluación inicial <span>→</span></a>
        <small>Orientación online · Confidencial · Atención en español</small>
      </section>
    </main>

    <footer>
      <div class="footer-brand">
        <img src="/logo-mariposa-con-fondo-completo.svg" alt="" width="38" height="38" />
        <span>Alma Holística</span>
      </div>
      <p>La biodescodificación es un proceso complementario de autoconocimiento y no reemplaza la atención médica.</p>
      <span>© 2026</span>
    </footer>

    <ProposalDock active="editorial" />
  </div>
</ProposalLayout>

<style>
  :global(html) { background: #f5f0e7; }

  .editorial-page {
    --paper: #f5f0e7;
    --paper-deep: #ebe2d4;
    --ink: #173d36;
    --ink-soft: #527069;
    --clay: #c8704d;
    --sage: #b9c9b2;
    color: var(--ink);
    background: var(--paper);
    font-family: 'DM Sans', sans-serif;
  }

  .site-header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: min(1420px, calc(100% - 72px));
    height: 92px;
    margin: 0 auto;
    border-bottom: 1px solid rgba(23, 61, 54, 0.18);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 11px;
    width: max-content;
    font: 500 19px/1 'Newsreader', serif;
    text-decoration: none;
  }

  .logo img {
    width: 40px;
    height: 40px;
    border-radius: 50%;
  }

  .logo em { font-style: italic; }

  .site-header nav {
    display: flex;
    align-items: center;
    gap: 34px;
  }

  .site-header nav a {
    position: relative;
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
  }

  .site-header nav a::after {
    position: absolute;
    right: 0;
    bottom: -7px;
    left: 0;
    height: 1px;
    background: currentColor;
    content: '';
    transform: scaleX(0);
    transition: transform 180ms ease;
  }

  .site-header nav a:hover::after { transform: scaleX(1); }

  .header-cta {
    justify-self: end;
    padding: 12px 21px;
    border: 1px solid var(--ink);
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    transition: 180ms ease;
  }

  .header-cta:hover { color: var(--paper); background: var(--ink); }

  .hero {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: clamp(36px, 6vw, 96px);
    width: min(1420px, calc(100% - 72px));
    min-height: calc(100vh - 92px);
    margin: 0 auto;
    padding: 70px 0 82px;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 30px;
    color: var(--ink-soft);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .eyebrow span {
    width: 24px;
    height: 1px;
    background: var(--clay);
  }

  .hero h1,
  .section-heading h2,
  .belief p,
  .process h2,
  .closing h2 {
    font-family: 'Newsreader', serif;
    font-weight: 400;
    letter-spacing: -0.05em;
  }

  .hero h1 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(4rem, 7vw, 7.6rem);
    line-height: 0.88;
  }

  .hero h1 em,
  .section-heading h2 em,
  .belief p em,
  .process h2 em,
  .closing h2 em { color: var(--clay); font-weight: 400; }

  .hero__intro {
    max-width: 580px;
    margin: 34px 0 0;
    color: var(--ink-soft);
    font-size: clamp(1rem, 1.35vw, 1.18rem);
    line-height: 1.7;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-top: 34px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    min-height: 54px;
    padding: 0 25px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition: 200ms ease;
  }

  .button svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }

  .button--primary { color: #fff !important; background: var(--clay); }
  .button--primary:hover { transform: translateY(-2px); background: #ae5b3e; }

  .text-link {
    padding-bottom: 5px;
    border-bottom: 1px solid rgba(23, 61, 54, 0.32);
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
  }

  .text-link span { margin-left: 5px; color: var(--clay); }

  .hero__trust {
    display: flex;
    gap: clamp(20px, 4vw, 52px);
    margin-top: 56px;
    padding-top: 23px;
    border-top: 1px solid rgba(23, 61, 54, 0.17);
  }

  .hero__trust div { display: flex; flex-direction: column; gap: 5px; }
  .hero__trust strong { font: 500 23px/1 'Newsreader', serif; }
  .hero__trust span { color: var(--ink-soft); font-size: 10px; letter-spacing: .05em; text-transform: uppercase; }

  .hero__visual { position: relative; padding: 0 36px 72px 0; }

  .hero__image-wrap {
    position: relative;
    overflow: hidden;
    aspect-ratio: .82;
    border-radius: 48% 48% 12px 12px;
    background: var(--paper-deep);
  }

  .hero__image-wrap::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(28, 44, 37, .24), transparent 45%);
    content: '';
  }

  .hero__image-wrap img { width: 100%; height: 100%; object-fit: cover; }

  blockquote {
    position: absolute;
    right: 0;
    bottom: 16px;
    z-index: 2;
    max-width: 330px;
    margin: 0;
    padding: 24px 26px 24px 54px;
    border-radius: 2px;
    color: #fff;
    background: var(--ink);
    font: 400 17px/1.45 'Newsreader', serif;
  }

  blockquote > span {
    position: absolute;
    top: 16px;
    left: 21px;
    color: var(--sage);
    font-size: 38px;
    line-height: 1;
  }

  .hero__seal {
    position: absolute;
    top: 24px;
    left: -56px;
    display: grid;
    width: 106px;
    height: 106px;
    place-items: center;
    border-radius: 50%;
    color: var(--ink);
    background: var(--sage);
  }

  .hero__seal svg { position: absolute; inset: 7px; width: 92px; height: 92px; animation: rotate 20s linear infinite; }
  .hero__seal text { fill: currentColor; font: 700 7px/1 'DM Sans', sans-serif; letter-spacing: 1.8px; }
  .hero__seal > span { font: 500 20px/1 'Newsreader', serif; }

  @keyframes rotate { to { transform: rotate(360deg); } }

  .symptoms {
    padding: clamp(78px, 10vw, 150px) max(36px, calc((100vw - 1420px) / 2));
    background: #eee6db;
  }

  .section-heading {
    display: grid;
    grid-template-columns: 70px 1fr auto;
    align-items: end;
    margin-bottom: 56px;
  }

  .section-number { align-self: start; padding-top: 8px; color: var(--clay); font-size: 11px; font-weight: 700; letter-spacing: .16em; }
  .section-heading p { margin: 0 0 13px; color: var(--ink-soft); font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .section-heading h2 { margin: 0; font-size: clamp(2.8rem, 5vw, 5.6rem); line-height: .97; }
  .section-heading > a { margin-bottom: 8px; font-size: 12px; font-weight: 700; text-decoration: none; }
  .section-heading > a span { color: var(--clay); }

  .symptom-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-left: 70px; }
  .symptom-card { display: block; text-decoration: none; }
  .symptom-card__image { position: relative; overflow: hidden; aspect-ratio: 1.1; background: #ddd2c2; }
  .symptom-card__image img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.78) sepia(.08); transition: transform 600ms cubic-bezier(.2,.7,.2,1); }
  .symptom-card:hover img { transform: scale(1.045); }
  .symptom-card__image > span { position: absolute; top: 16px; left: 16px; display: grid; width: 34px; height: 34px; place-items: center; border-radius: 50%; color: var(--ink); background: var(--paper); font-size: 10px; font-weight: 700; }
  .symptom-card__copy { position: relative; padding: 22px 44px 0 0; }
  .symptom-card h3 { margin: 0 0 7px; font: 500 clamp(1.45rem, 2.2vw, 2.05rem)/1 'Newsreader', serif; }
  .symptom-card p { margin: 0; color: var(--ink-soft); font-size: 13px; line-height: 1.55; }
  .symptom-card .arrow { position: absolute; top: 22px; right: 5px; font-size: 20px; transition: transform 180ms ease; }
  .symptom-card:hover .arrow { transform: translate(3px, -3px); }

  .belief {
    position: relative;
    display: grid;
    min-height: 620px;
    place-items: center;
    overflow: hidden;
    padding: 110px 36px;
    text-align: center;
  }

  .belief__label { position: absolute; top: 54px; left: 50%; transform: translateX(-50%); color: var(--ink-soft); font-size: 10px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  .belief p { position: relative; z-index: 2; max-width: 1050px; margin: 0; font-size: clamp(3.1rem, 6vw, 6.3rem); line-height: .99; }
  .belief__flower { position: absolute; width: 440px; height: 440px; opacity: .32; }
  .belief__flower span { position: absolute; top: 50%; left: 50%; width: 48%; height: 48%; border: 1px solid var(--clay); border-radius: 100% 0 100% 0; transform-origin: 0 0; }
  .belief__flower span:nth-child(1) { transform: rotate(0deg); }
  .belief__flower span:nth-child(2) { transform: rotate(90deg); }
  .belief__flower span:nth-child(3) { transform: rotate(180deg); }
  .belief__flower span:nth-child(4) { transform: rotate(270deg); }

  .process {
    display: grid;
    grid-template-columns: .85fr 1.15fr;
    gap: clamp(50px, 9vw, 140px);
    padding: clamp(90px, 11vw, 160px) max(36px, calc((100vw - 1420px) / 2));
    color: #f5f0e7;
    background: var(--ink);
  }

  .process__intro > p { max-width: 420px; margin: 55px 0 24px; color: #a9bdb7; font-size: 14px; line-height: 1.65; }
  .process h2 { margin: 0; font-size: clamp(3rem, 5.5vw, 6rem); line-height: .95; }
  .process h2 em { color: #d79a7f; }
  .process__steps { margin: 0; padding: 0; list-style: none; }
  .process__steps li { display: grid; grid-template-columns: 62px 1fr; gap: 24px; padding: 36px 0; border-top: 1px solid rgba(255,255,255,.16); }
  .process__steps li:last-child { border-bottom: 1px solid rgba(255,255,255,.16); }
  .step-number { color: #d79a7f; font-size: 11px; font-weight: 700; letter-spacing: .14em; }
  .process__steps h3 { margin: 0 0 10px; font: 500 2rem/1 'Newsreader', serif; }
  .process__steps p { max-width: 520px; margin: 0; color: #a9bdb7; font-size: 14px; line-height: 1.65; }

  .closing {
    position: relative;
    display: flex;
    min-height: 670px;
    align-items: center;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    padding: 100px 30px;
    text-align: center;
    background: var(--sage);
  }

  .closing > p { margin: 0 0 22px; font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .closing h2 { position: relative; z-index: 1; margin: 0 0 36px; font-size: clamp(4rem, 7vw, 7rem); line-height: .88; }
  .button--light { position: relative; z-index: 1; color: var(--paper) !important; background: var(--ink); }
  .button--light:hover { transform: translateY(-2px); background: #0d2c27; }
  .closing small { margin-top: 19px; color: rgba(23,61,54,.66); font-size: 10px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .closing__leaf { position: absolute; width: 330px; height: 520px; border: 1px solid rgba(23,61,54,.17); border-radius: 100% 0 100% 0; }
  .closing__leaf--left { left: -140px; bottom: -210px; transform: rotate(15deg); }
  .closing__leaf--right { top: -250px; right: -120px; transform: rotate(195deg); }

  footer {
    display: grid;
    grid-template-columns: 1fr 2fr auto;
    align-items: center;
    gap: 34px;
    padding: 38px max(36px, calc((100vw - 1420px) / 2)) 100px;
    color: #b2c2bd;
    background: var(--ink);
  }

  .footer-brand { display: flex; align-items: center; gap: 10px; color: #fff; font: 500 18px/1 'Newsreader', serif; }
  .footer-brand img { width: 36px; height: 36px; border-radius: 50%; }
  footer p { max-width: 690px; margin: 0; font-size: 10px; line-height: 1.55; }
  footer > span { font-size: 11px; }

  @media (max-width: 980px) {
    .site-header { grid-template-columns: 1fr auto; }
    .site-header nav { display: none; }
    .hero { grid-template-columns: 1fr; padding-top: 90px; }
    .hero__copy { max-width: 760px; }
    .hero__visual { width: min(620px, 92%); margin-left: auto; }
    .section-heading { grid-template-columns: 50px 1fr; }
    .section-heading > a { display: none; }
    .symptom-grid { margin-left: 50px; }
    .process { grid-template-columns: 1fr; }
    .process__intro { max-width: 720px; }
  }

  @media (max-width: 700px) {
    .site-header, .hero { width: min(100% - 36px, 1420px); }
    .site-header { height: 76px; }
    .logo span { font-size: 17px; }
    .logo img { width: 36px; height: 36px; }
    .header-cta { padding: 10px 15px; }
    .hero { min-height: auto; padding: 68px 0 72px; }
    .hero h1 { font-size: clamp(3.55rem, 16vw, 5.3rem); }
    .hero__intro { margin-top: 26px; }
    .hero__actions { align-items: flex-start; flex-direction: column; gap: 20px; }
    .hero__trust { gap: 22px; }
    .hero__trust strong { font-size: 19px; }
    .hero__trust span { font-size: 8px; }
    .hero__visual { width: calc(100% - 18px); padding: 0 0 84px; }
    .hero__seal { top: -38px; left: -18px; width: 92px; height: 92px; }
    .hero__seal svg { width: 78px; height: 78px; }
    blockquote { right: -18px; max-width: calc(100% - 28px); }
    .symptoms { padding-right: 18px; padding-left: 18px; }
    .section-heading { grid-template-columns: 1fr; }
    .section-number { margin-bottom: 22px; }
    .section-heading h2 { font-size: 3.2rem; }
    .symptom-grid { grid-template-columns: 1fr; gap: 40px; margin-left: 0; }
    .belief { min-height: 520px; padding-right: 20px; padding-left: 20px; }
    .belief p { font-size: 3.2rem; }
    .belief__flower { width: 310px; height: 310px; }
    .process { padding-right: 20px; padding-left: 20px; }
    .process__intro > p { margin-top: 30px; }
    .process h2 { font-size: 3.3rem; }
    .process__steps li { grid-template-columns: 44px 1fr; gap: 10px; }
    .closing { min-height: 590px; }
    .closing h2 { font-size: 4.1rem; }
    footer { grid-template-columns: 1fr; padding-right: 20px; padding-left: 20px; }
  }
</style>
