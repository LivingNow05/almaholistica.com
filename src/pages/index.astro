      <div class="bg-[#0A1226] border border-slate-800/40 rounded-[2.5rem] p-10 lg:p-14">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 pb-4 border-b border-slate-800/40">
