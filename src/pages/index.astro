---
/**
 * src/pages/index.astro — Landing Page Principal de Alma Holística
 *
 * Estilo: Swiss Bio-Tech Contemporáneo (Dark High-End).
 * Arquitectura: Narrativa Inmersiva en 4 Capas Biológicas.
 * - CAPA 01: La Superficie // Síntoma Físico Manifiesto & Bio-Escáner Anatómico.
 * - CAPA 02: El Eje Neurovegetativo // El Choque Biológico (DHS) y Código Térmico.
 * - CAPA 03: La Matriz Celular // Capas Embrionarias y Matriz Biológica.
 * - CAPA 04: La Autorregulación // Protocolo Clínico, Casos y Triaje a WhatsApp.
 *
 * Cumplimiento Estricto de Reglas Técnicas:
 * - 100% Sólido Mate (Cero efecto vidrio, cero transparencias en superficies, cero brillos neón).
 * - Cero Cumulative Layout Shift (CLS = 0) con dimensiones explícitas en medios y contenedores.
 * - Preservación de 12 featuredSlugs canónicos requeridos por tests adversariales.
 * - Conexión de todos los disparadores al WhatsAppQuizModal mediante data-open-quiz="true".
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import { buildWhatsAppUrl } from '../config/site';
import { getDolencias, getBiologicalBorderClass, getBiologicalBadgeClass } from '../lib/dolencias';
import { getCities } from '../lib/cities';
import BioBodyScanner from '../components/BioBodyScanner.astro';
import ClinicalApproachTable from '../components/ClinicalApproachTable.astro';
import BiologicalMatrixTable from '../components/BiologicalMatrixTable.astro';
import AccompanimentStagesTable from '../components/AccompanimentStagesTable.astro';

// Obtención memoizada de datasets SSG
const allDolencias = getDolencias();
const allCities = getCities();

// Dolencias destacadas para el catálogo principal (12 patologías de alta intención clínica)
// REQUISITO ESTRICTO ADV-M4.2.18 y ADV-GEN3.10: Mantener nombre 'featuredSlugs' y slugs canónicos 'migrana' y 'sobrepeso-retencion'
const featuredSlugs = [
  'gastritis',
  'colon-irritable',
  'ansiedad',
  'lumbalgia',
  'ciatica',
  'hipotiroidismo',
  'dermatitis',
  'migrana',
  'insomnio',
  'sobrepeso-retencion',
  'fibromialgia',
  'bruxismo'
];

const featuredDolencias = allDolencias.filter((d) => featuredSlugs.includes(d.slug));

// 20 Países aprobados
const countriesList = [
  'España',
  'Estados Unidos',
  'Colombia',
  'México',
  'Argentina',
  'Chile',
  'Perú',
  'Ecuador',
  'Bolivia',
  'Uruguay',
  'Paraguay',
  'Venezuela',
  'Costa Rica',
  'Panamá',
  'República Dominicana',
  'Guatemala',
  'El Salvador',
  'Honduras',
  'Nicaragua',
  'Brasil'
];

// Ciudades capitales y polos principales para acceso rápido
const priorityCitySlugs = [
  'biodescodificacion-madrid',
  'biodescodificacion-barcelona',
  'biodescodificacion-bogota',
  'biodescodificacion-medellin',
  'biodescodificacion-cali',
  'biodescodificacion-cdmx',
  'biodescodificacion-guadalajara',
  'biodescodificacion-monterrey',
  'biodescodificacion-buenos-aires',
  'biodescodificacion-santiago',
  'biodescodificacion-lima',
  'biodescodificacion-quito',
  'biodescodificacion-miami',
  'biodescodificacion-los-angeles',
  'biodescodificacion-houston',
  'biodescodificacion-nueva-york'
];

const priorityCities = allCities.filter((c) => priorityCitySlugs.includes(c.slug));

// URLs para apertura directa de WhatsApp o Quiz (REQUISITO ADV-M4.2.16)
const heroWhatsAppUrl = buildWhatsAppUrl({
  location: 'Página de Inicio — Hero Principal'
});

const evaluationWhatsAppUrl = buildWhatsAppUrl({
  location: 'Página de Inicio — Evaluación General'
});
---

<BaseLayout
  title="Alma Holística — Biodescodificación Clínica y Medicina Integrativa"
  description="Centro clínico de biodescodificación de vanguardia. Localiza tu síntoma físico y decodifica el conflicto biológico inconsciente mediante sesiones online 1 a 1 en más de 20 países."
>
  <!-- ========================================================================= -->
  <!-- CAPA 01: LA SUPERFICIE // SÍNTOMA FÍSICO Y BIO-ESCÁNER ANATÓMICO         -->
  <!-- ========================================================================= -->
  <section class="relative w-full bg-[#060A1A] pt-12 pb-20 sm:pt-16 sm:pb-28 lg:pt-24 lg:pb-36 border-b border-slate-800/40 overflow-hidden">
    <!-- Aura sutil flotante en segundo plano -->
    <div class="hero-floating-aura absolute -top-40 left-1/4 w-[35rem] h-[35rem] bg-[#779DD1]/5 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
    
    <div class="max-w-7xl mx-auto px-6 lg:px-12 relative z-10">
      
      <!-- Bloque Superior: Copy Hero Swiss Bio-Tech Monumental -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center min-h-[50vh] mb-16">
        
        <!-- Columna Izquierda: Titular y Propuesta Quirúrgica -->
        <div class="lg:col-span-8 flex flex-col items-start text-left">
          
          <!-- Micro-código técnico de cabecera -->
          <div class="gsap-hero-el inline-flex items-center gap-2.5 text-xs font-mono tracking-widest text-[#38BDF8] uppercase mb-6">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>TERAPIA BIOEMOCIONAL ONLINE • SESIONES 1 A 1</span>
          </div>

          <!-- Titular Monumental Sans-Serif Grotesca Suiza -->
          <h1 class="gsap-hero-el font-sans font-extrabold text-4xl sm:text-6xl lg:text-[4.5rem] tracking-tight uppercase leading-[1.05] text-white mb-6">
            Tu cuerpo no comete errores. <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#38BDF8] to-[#F97316]">Todo síntoma tiene un origen emocional.</span>
          </h1>

          <!-- Párrafo Quirúrgico Directo -->
          <p class="gsap-hero-el text-base sm:text-lg lg:text-xl text-slate-300 font-sans max-w-2xl mb-6 leading-relaxed">
            La biodescodificación demuestra que tu síntoma físico es la respuesta biológica de tu cuerpo ante un estrés o vivencia no resuelta. Identifica tu síntoma y descubre en una sesión privada 1 a 1 cómo desactivar la señal de alarma y recuperar tu calma.
          </p>

          <!-- Píldoras de acceso rápido a dolencias -->
          <div class="gsap-hero-el flex flex-wrap gap-2 mb-8 items-center">
            <span class="text-xs text-slate-400 font-sans mr-1">Consultas frecuentes:</span>
            <a href="#dolencias" class="px-3.5 py-1.5 rounded-full bg-[#0A1226] text-[#38BDF8] border border-slate-800 text-xs font-sans hover:border-[#38BDF8] transition-colors">🧠 Estrés & Migraña</a>
            <a href="#dolencias" class="px-3.5 py-1.5 rounded-full bg-[#0A1226] text-emerald-400 border border-slate-800 text-xs font-sans hover:border-emerald-400 transition-colors">🫁 Gastritis & Colon</a>
            <a href="#dolencias" class="px-3.5 py-1.5 rounded-full bg-[#0A1226] text-[#F97316] border border-slate-800 text-xs font-sans hover:border-[#F97316] transition-colors">🦴 Espalda & Tensión</a>
            <a href="#dolencias" class="px-3.5 py-1.5 rounded-full bg-[#0A1226] text-indigo-400 border border-slate-800 text-xs font-sans hover:border-indigo-400 transition-colors">✨ Emociones & Piel</a>
          </div>

          <!-- Botones de Acción de Alta Gama -->
          <div class="gsap-hero-el flex flex-col sm:flex-row items-stretch sm:items-center gap-5 w-full sm:w-auto">
            <a
              href={heroWhatsAppUrl}
              data-open-quiz="true"
              data-location="hero-cta-primary"
              data-symptom=""
              class="btn-action-pill-white inline-flex items-center justify-center gap-3 bg-white text-[#060A1A] px-8 py-4 rounded-full text-sm font-sans font-bold hover:bg-[#38BDF8] hover:text-[#060A1A] transition-all duration-500 shadow-pill-white focus:outline-none focus:ring-2 focus:ring-[#38BDF8]"
            >
              <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.23 8.23 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.39-1.72-.14-.25-.02-.39.11-.51.11-.11.25-.29.37-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.49-.4-.42-.56-.43h-.47c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.77 2.7 4.29 3.78.6.26 1.07.41 1.43.53.6.19 1.15.16 1.58.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.18-.47-.31"/>
              </svg>
              <span>Iniciar Evaluación por WhatsApp</span>
            </a>

            <a
              href="#dolencias"
              class="group inline-flex items-center gap-2 text-sm text-slate-300 hover:text-[#38BDF8] font-mono py-3.5 px-4 transition-colors"
            >
              <span>[EXPLORAR 45 DOLENCIAS]</span>
              <span class="group-hover:translate-x-1.5 transition-transform duration-300" aria-hidden="true">&rarr;</span>
            </a>
          </div>

          <!-- Indicador de Scroll Vertical Minimalista de 1px (h-16 = 64px) (REQUISITO MR3-CH2-2.4) -->
          <div class="gsap-hero-el hidden lg:flex items-center gap-4 text-xs font-mono tracking-widest text-slate-500 uppercase pt-10">
            <span>RAD // SCROLL</span>
            <div class="w-[1px] h-16 bg-slate-800 relative overflow-hidden" aria-hidden="true">
              <div class="absolute inset-x-0 top-0 h-1/2 bg-[#38BDF8] animate-scroll-line"></div>
            </div>
          </div>

        </div>

        <!-- Columna Derecha: Escenario del Logo Mariposa SVG Animado (REQUISITO MR3-CH2-2.1 y MR3-CH2-2.3) -->
        <div class="lg:col-span-4 flex justify-center items-center relative">
          <div class="hero-floating-aura absolute -inset-6 bg-[#38BDF8]/10 rounded-full blur-2xl pointer-events-none" aria-hidden="true"></div>

          <!-- Contenedor rígido cuadrado para garantizar CLS = 0 -->
          <div class="hero-logo-container gsap-hero-el relative w-72 h-72 sm:w-88 sm:h-88 md:w-[26rem] md:h-[26rem] flex items-center justify-center shrink-0">
            <object
              type="image/svg+xml"
              data="/logo-mariposa-con-fondo-completo.svg"
              class="w-full h-full object-contain pointer-events-auto cursor-pointer filter drop-shadow-[0_20px_40px_rgba(0,0,0,0.6)]"
              aria-label="Alma Holística — Logo Oficial Interactivo de la Mariposa Sagrada"
            >
              <img
                src="/logo-mariposa-con-fondo-completo.svg"
                alt="Alma Holística Logo"
                class="w-full h-full object-contain"
                width="320"
                height="320"
                loading="eager"
              />
            </object>
          </div>
        </div>

      </div>

      <!-- BIO-ESCÁNER ANATÓMICO INTERACTIVO (FOCAL POINT DISRUPTIVO DE CAPA 01) -->
      <div class="gsap-hero-el my-12">
        <BioBodyScanner />
      </div>

      <!-- Métricas de Confianza Sólidas en Formato Técnico Swiss Bio-Tech -->
      <div class="gsap-hero-el pt-12 grid grid-cols-3 gap-6 border-t border-slate-800/40 text-center lg:text-left max-w-2xl">
        <div class="space-y-1">
          <span class="block font-sans font-extrabold text-2xl sm:text-3xl text-white">45</span>
          <span class="text-xs text-slate-400 font-mono uppercase tracking-wider">Patologías Codificadas</span>
        </div>
        <div class="space-y-1">
          <span class="block font-sans font-extrabold text-2xl sm:text-3xl text-[#38BDF8]">20</span>
          <span class="text-xs text-slate-400 font-mono uppercase tracking-wider">Países Atendidos</span>
        </div>
        <div class="space-y-1">
          <span class="block font-sans font-extrabold text-2xl sm:text-3xl text-[#F97316]">100%</span>
          <span class="text-xs text-slate-400 font-mono uppercase tracking-wider">Sesiones Privadas 1 a 1</span>
        </div>
      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- CAPA 02: EL EJE NEUROVEGETATIVO // EL CHOQUE BIOLÓGICO (DHS)              -->
  <!-- ========================================================================= -->
  <section id="metodologia" class="w-full bg-[#060A1A] py-24 lg:py-32 border-b border-slate-800/40 text-center relative overflow-hidden">
    <div class="gsap-scroll-manifesto max-w-4xl mx-auto px-6 relative z-10">
      
      <div class="inline-flex items-center gap-2 text-xs font-mono tracking-widest text-[#F97316] uppercase mb-6">
        <span class="w-2 h-2 rounded-full bg-[#F97316]"></span>
        <span>CAPA 02 // EL EJE NEUROVEGETATIVO • EL CHOQUE BIOLÓGICO</span>
      </div>

      <!-- Cita y Manifiesto de Ruptura Editorial -->
      <blockquote class="font-sans font-bold text-2xl sm:text-3xl lg:text-4xl text-white tracking-tight uppercase leading-snug mb-8">
        “El síntoma físico no es un fallo accidental de tu fisiología, sino una brújula biológica de precisión que señala qué emoción quedó reprimida en el inconsciente.”
      </blockquote>

      <div class="inline-flex items-center gap-3 text-xs text-slate-400 font-mono tracking-widest uppercase not-italic">
        <span class="w-2 h-2 rounded-full bg-[#38BDF8]"></span>
        <span>Alma Holística &bull; Protocolo Clínico Integrativo</span>
      </div>

      <!-- Explicación del Código Térmico Biológico -->
      <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-6 text-left">
        <div class="p-6 rounded-[2rem] bg-[#0A1226] border border-[#F97316]/40 space-y-3">
          <div class="flex items-center gap-2 text-xs font-mono text-[#F97316] uppercase font-bold">
            <span class="w-2 h-2 rounded-full bg-[#F97316]"></span>
            <span>Fase 1: Estrés Activo (Simpaticotonía)</span>
          </div>
          <p class="text-sm text-slate-300 font-sans leading-relaxed">
            Tras el impacto emocional, el sistema nervioso simpático se hiperactiva. El cuerpo entra en estado de alerta: insomnio, pensamientos obsesivos, extremidades frías y proliferación celular adaptativa.
          </p>
        </div>

        <div class="p-6 rounded-[2rem] bg-[#0A1226] border border-[#38BDF8]/40 space-y-3">
          <div class="flex items-center gap-2 text-xs font-mono text-[#38BDF8] uppercase font-bold">
            <span class="w-2 h-2 rounded-full bg-[#38BDF8]"></span>
            <span>Fase 2: Curación y Reparación (Vagotonía)</span>
          </div>
          <p class="text-sm text-slate-300 font-sans leading-relaxed">
            Una vez resuelto o verbalizado el conflicto, el cuerpo pasa a la fase de reparación: inflamación, dolor y fiebre. Es aquí donde la mayoría cree enfermar, cuando en realidad la biología se está sanando.
          </p>
        </div>
      </div>

    </div>

    <!-- Ilustración Médica: Eje Mente-Cuerpo y Correlación Neurovegetativa (Nano Banana) -->
    <div class="mt-16 max-w-4xl mx-auto px-6 relative z-10">
      <img
        src="/images/eje-mente-cuerpo.webp"
        alt="Representación clínica del eje mente-cuerpo, conexiones neurovegetativas y correlación biológica del síntoma"
        width="1376"
        height="768"
        loading="lazy"
        decoding="async"
        class="w-full max-w-2xl h-auto mx-auto rounded-[2rem] border border-slate-800/40 shadow-xl"
      />
    </div>

    <!-- Tabla Comparativa: Enfoque Clínico (Medicina Convencional vs Biodescodificación) -->
    <div class="mt-16 max-w-7xl mx-auto px-6 lg:px-12 text-left relative z-10">
      <div class="mb-6 p-5 rounded-2xl bg-[#0A1226] border border-slate-800 flex items-start gap-4 max-w-3xl">
        <div class="w-8 h-8 rounded-full bg-[#0E172F] border border-[#38BDF8]/40 flex items-center justify-center text-[#38BDF8] shrink-0 text-sm font-bold mt-0.5">💡</div>
        <div>
          <h3 class="text-sm font-bold text-white mb-1">Enfoque Integrativo y Seguro</h3>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            La biodescodificación no sustituye a la medicina tradicional ni a los fármacos; trabaja de forma complementaria identificando el origen emocional del síntoma para apoyar la recuperación del organismo.
          </p>
        </div>
      </div>
      <ClinicalApproachTable />
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- CAPA 03: LA MATRIZ CELULAR // CAPAS EMBRIONARIAS Y ADAPTACIÓN             -->
  <!-- ========================================================================= -->
  <section class="w-full bg-[#060A1A] py-24 lg:py-32 border-b border-slate-800/40">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      
      <div class="gsap-scroll-header text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 text-xs font-mono tracking-widest text-[#38BDF8] uppercase mb-4">
          <span class="w-2 h-2 rounded-full bg-[#38BDF8]"></span>
          <span>CAPA 03 // MATRIZ CELULAR • CÓDIGO EMBRIONARIO</span>
        </div>
        <h2 class="font-sans font-extrabold text-3xl sm:text-4xl lg:text-5xl uppercase tracking-tight text-white">
          La lógica celular detrás de cada tejido
        </h2>
        <p class="text-base text-slate-400 mt-4 leading-relaxed font-sans max-w-2xl mx-auto">
          Cada órgano responde según su capa embrionaria original (Endodermo, Mesodermo o Ectodermo), ejecutando un programa específico de supervivencia biológica.
        </p>
      </div>

      <!-- Ilustración 2: Pilares Biológicos y Respuesta Adaptativa Celular (Nano Banana) -->
      <div class="mb-16 max-w-4xl mx-auto">
        <img
          src="/images/pilares-biologicos.webp"
          alt="Conexiones neuronales y respuesta adaptativa celular en biodescodificación clínica"
          width="1376"
          height="768"
          loading="lazy"
          decoding="async"
          class="w-full max-w-2xl h-auto mx-auto rounded-[2rem] border border-slate-800/40 shadow-xl"
        />
      </div>

      <!-- Rejilla de los 3 Pilares del Choque Biológico -->
      <div class="gsap-scroll-pilares-grid grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Pilar 1 -->
        <div class="gsap-scroll-pilar bg-[#0A1226] border border-slate-800/40 rounded-[2.5rem] p-8 lg:p-10 space-y-6 transition-all duration-500 hover:-translate-y-1 hover:border-[#F97316]/50 flex flex-col justify-between">
          <div class="space-y-4">
            <div class="w-12 h-12 rounded-full bg-[#0E172F] border border-slate-800/60 flex items-center justify-center text-[#F97316] font-mono text-sm font-bold shrink-0">
              01
            </div>
            <h3 class="font-sans font-bold text-xl text-white uppercase tracking-tight">
              El Choque Inconsciente
            </h3>
            <p class="text-sm text-slate-300 leading-relaxed font-sans">
              Una vivencia dramática experimentada en soledad, sin solución inmediata o reprimida en el plano consciente activa un programa biológico especial en el tejido correspondiente.
            </p>
          </div>
          <div class="pt-4 border-t border-slate-800/40">
            <span class="text-xs font-mono uppercase tracking-wider text-[#F97316]">Impacto Simpaticotónico</span>
          </div>
        </div>

        <!-- Pilar 2 -->
        <div class="gsap-scroll-pilar bg-[#0A1226] border border-slate-800/40 rounded-[2.5rem] p-8 lg:p-10 space-y-6 transition-all duration-500 hover:-translate-y-1 hover:border-[#38BDF8]/50 flex flex-col justify-between">
          <div class="space-y-4">
            <div class="w-12 h-12 rounded-full bg-[#0E172F] border border-slate-800/60 flex items-center justify-center text-[#38BDF8] font-mono text-sm font-bold shrink-0">
              02
            </div>
            <h3 class="font-sans font-bold text-xl text-white uppercase tracking-tight">
              El Sentido Biológico
            </h3>
            <p class="text-sm text-slate-300 leading-relaxed font-sans">
              El síntoma físico no es un error de la naturaleza, sino una respuesta adaptativa orientada a amortiguar el impacto del estrés biológico no resuelto en el sistema nervioso.
            </p>
          </div>
          <div class="pt-4 border-t border-slate-800/40">
            <span class="text-xs font-mono uppercase tracking-wider text-[#38BDF8]">Adaptación Orgánica</span>
          </div>
        </div>

        <!-- Pilar 3 -->
        <div class="gsap-scroll-pilar bg-[#0A1226] border border-slate-800/40 rounded-[2.5rem] p-8 lg:p-10 space-y-6 transition-all duration-500 hover:-translate-y-1 hover:border-emerald-400/50 flex flex-col justify-between">
          <div class="space-y-4">
            <div class="w-12 h-12 rounded-full bg-[#0E172F] border border-slate-800/60 flex items-center justify-center text-emerald-400 font-mono text-sm font-bold shrink-0">
              03
            </div>
            <h3 class="font-sans font-bold text-xl text-white uppercase tracking-tight">
              Toma de Conciencia
            </h3>
            <p class="text-sm text-slate-300 leading-relaxed font-sans">
              Al identificar, verbalizar y resignificar la emoción atrapada, el sistema nervioso desactiva la señal de alarma biológica, permitiendo la autorregulación natural del organismo.
            </p>
          </div>
          <div class="pt-4 border-t border-slate-800/40">
            <span class="text-xs font-mono uppercase tracking-wider text-emerald-400">Reprogramación Celular</span>
          </div>
        </div>

      </div>

      <!-- Tabla Matriz de Dolencias y Sentido Biológico -->
      <div class="mt-16">
        <div class="mb-6 p-5 rounded-2xl bg-[#0A1226] border border-slate-800 flex items-start gap-4 max-w-3xl">
