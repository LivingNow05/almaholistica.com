  <!-- ========================================================================= -->
  <!-- SCRIPTS: GSAP ENTRANCE, LOOP SINUSOIDAL & BÚSQUEDA DINÁMICA               -->
  <!-- ========================================================================= -->
  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    // Animación suave de entrada escalonada y cinemáticas ScrollTrigger en todo el sitio
    const initHeroAnimations = () => {
      const prefersReducedMotion = typeof window !== 'undefined' && 
        window.matchMedia && 
        window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!prefersReducedMotion) {
        // 1. Hero Entrance: Staggered fade-in-up con curva suave y garantía estricta de CLS = 0
        gsap.from('.gsap-hero-el, .gsap-fade-up', {
          opacity: 0,
          y: 35,
          duration: 1.1,
          stagger: 0.1,
          ease: 'power3.out',
          clearProps: 'transform,opacity'
        });

        // 2. Floating Aura: Loop sinusoidal continuo orgánico en segundo plano detrás de la mariposa
        gsap.to('.hero-floating-aura', {
          y: -14,
          scale: 1.06,
          duration: 5,
          repeat: -1,
          yoyo: true,
          ease: 'sine.inOut'
        });

        // 3. ScrollTrigger: Encabezados Editoriales de Sección
        gsap.utils.toArray('.gsap-scroll-header').forEach((header: any) => {
          gsap.from(header, {
            scrollTrigger: {
              trigger: header,
              start: 'top 85%',
              toggleActions: 'play none none reverse'
            },
            opacity: 0,
            y: 35,
            duration: 0.9,
            ease: 'power3.out',
            clearProps: 'transform,opacity'
          });
        });

        // 4. ScrollTrigger: Manifiesto Biológico (Cita Editorial)
        const manifesto = document.querySelector('.gsap-scroll-manifesto');
        if (manifesto) {
          gsap.from(manifesto, {
            scrollTrigger: {
              trigger: manifesto,
              start: 'top 82%',
              toggleActions: 'play none none reverse'
            },
            opacity: 0,
            scale: 0.98,
            y: 25,
            duration: 1.1,
            ease: 'power3.out',
            clearProps: 'transform,opacity'
          });
        }

        // 5. ScrollTrigger: Pilares del Fundamento Terapéutico (Cascada 3 tarjetas)
        const pilaresGrid = document.querySelector('.gsap-scroll-pilares-grid');
        if (pilaresGrid) {
          gsap.from('.gsap-scroll-pilar', {
            scrollTrigger: {
              trigger: pilaresGrid,
              start: 'top 80%',
              toggleActions: 'play none none reverse'
            },
            opacity: 0,
            y: 45,
            duration: 0.9,
            stagger: 0.15,
            ease: 'power3.out',
            clearProps: 'transform,opacity'
          });
        }

        // 6. ScrollTrigger: Catálogo Clínico de Dolencias (Batch Reveal suave)
        ScrollTrigger.batch('.home-dolencia-card', {
          start: 'top 88%',
          onEnter: (batch) => {
            gsap.from(batch, {
              opacity: 0,
              y: 40,
              stagger: 0.08,
              duration: 0.8,
              ease: 'power3.out',
              clearProps: 'transform,opacity'
            });
          },
          once: true
        });

        // 7. ScrollTrigger: El Viaje Terapéutico (Pasos 01 al 04)
        const journeyGrid = document.querySelector('.gsap-scroll-journey-grid');
        if (journeyGrid) {
          gsap.from('.gsap-scroll-journey-step', {
            scrollTrigger: {
              trigger: journeyGrid,
              start: 'top 80%',
              toggleActions: 'play none none reverse'
            },
            opacity: 0,
            y: 40,
            duration: 0.85,
            stagger: 0.12,
            ease: 'power3.out',
            clearProps: 'transform,opacity'
          });
        }

        // 8. ScrollTrigger: Testimonios Clínicos
        const testimonialsGrid = document.querySelector('.gsap-scroll-testimonials-grid');
        if (testimonialsGrid) {
          gsap.from('.gsap-scroll-testimonial', {
            scrollTrigger: {
              trigger: testimonialsGrid,
              start: 'top 80%',
              toggleActions: 'play none none reverse'
            },
            opacity: 0,
            y: 40,
            duration: 0.9,
            stagger: 0.15,
            ease: 'power3.out',
            clearProps: 'transform,opacity'
          });
        }

        // 9. ScrollTrigger: Acordeón FAQs
        ScrollTrigger.batch('.gsap-scroll-faq', {
          start: 'top 90%',
          onEnter: (batch) => {
            gsap.from(batch, {
              opacity: 0,
              y: 30,
              stagger: 0.07,
              duration: 0.7,
              ease: 'power3.out',
              clearProps: 'transform,opacity'
            });
          },
          once: true
        });

        // 10. ScrollTrigger: Final CTA
        const finalCta = document.querySelector('.gsap-scroll-cta');
        if (finalCta) {
          gsap.from(finalCta, {
            scrollTrigger: {
              trigger: finalCta,
              start: 'top 85%',
              toggleActions: 'play none none reverse'
            },
            opacity: 0,
            y: 40,
            scale: 0.98,
            duration: 1,
            ease: 'power3.out',
            clearProps: 'transform,opacity'
          });
        }
      }
    };

    if (typeof window !== 'undefined') {
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initHeroAnimations);
      } else {
        initHeroAnimations();
      }
    }

    // Buscador interactivo de dolencias en home (REQUISITO FUNCIONAL CLIENTE)
    const symptomInput = document.getElementById('home-symptom-search') as HTMLInputElement | null;
    const dolenciasCards = document.querySelectorAll<HTMLElement>('.home-dolencia-card');

    if (symptomInput && dolenciasCards.length > 0) {
      symptomInput.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        const query = target.value.toLowerCase().trim();

        dolenciasCards.forEach((card) => {
          const searchData = card.getAttribute('data-search') || '';
          if (!query || searchData.includes(query)) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    }

    // Buscador interactivo de ciudades en home (REQUISITO FUNCIONAL CLIENTE)
    const cityInput = document.getElementById('home-city-search') as HTMLInputElement | null;
    const cityItems = document.querySelectorAll<HTMLElement>('.city-search-item');

    if (cityInput && cityItems.length > 0) {
      cityInput.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        const query = target.value.toLowerCase().trim();

        cityItems.forEach((item) => {
          const cityName = item.getAttribute('data-city-name') || '';
          if (!query || cityName.includes(query)) {
            item.style.display = 'block';
          } else {
            item.style.display = 'none';
          }
        });
      });
    }
  </script>
</BaseLayout>
