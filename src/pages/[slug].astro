---
/**
 * src/pages/[slug].astro — Ruta Dinámica SSG para Ciudades (SEO Hiperlocal)
 * Alma Holística (almaholistica.com)
 *
 * Genera estáticamente las páginas de más de 113 ciudades en los 20 países aprobados.
 * Estilo visual estricto: Sólido Mate (#060A1A, #0A1226, #0E172F, #1E293B, #779DD1, #779DD1).
 * Cero transparencias, cero brillos artificiales, cero desenfoques.
 * Cumple con R1, R2, R3, R4 y la suite de pruebas E2E (Features 15, Cruce 1, Journey A).
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import { getCities } from '../lib/cities';
import { getCountries, countryNameToSlug } from '../lib/countries';
import type { CityData } from '../types/city';
import type { CountryData } from '../types/country';
import CountryHubView from '../components/country/CountryHubView.astro';
import { SITE_CONFIG, buildWhatsAppUrl } from '../config/site';
import {
  buildLocalServiceSchema,
  buildBreadcrumbSchema,
  buildCountryMedicalWebPageSchema,
  buildFAQSchema
} from '../lib/schema';
import eeatCitiesData from '../data/dataset_almaholistica_ciudades_eeat_geo.json';

export async function getStaticPaths() {
  const cities = getCities();
  const countries = getCountries();

  const cityPaths = cities.map((city) => ({
    params: { slug: city.slug },
    props: { type: 'city' as const, city, country: null },
  }));

  const countryPaths = countries.map((country) => ({
    params: { slug: country.slug },
    props: { type: 'country' as const, city: null, country },
  }));

  return [...cityPaths, ...countryPaths];
}

export interface Props {
  type?: 'city' | 'country';
  city?: CityData | null;
  country?: CountryData | null;
}

const { type, city: propCity, country: propCountry } = Astro.props;
const isCountry = type === 'country' || (!propCity && Boolean(propCountry));

// Variables específicas para Country Hub
const country = propCountry;
const countrySlug = country?.slug || '';
const countryCanonicalUrl = `https://almaholistica.com/${countrySlug}/`;
const countryPageTitle = country ? `${country.h1} | ${SITE_CONFIG.name}` : '';
const countryMetaDesc = country?.metaDescripcion || '';

const countryMedicalSchema = country ? buildCountryMedicalWebPageSchema(country, countryCanonicalUrl) : null;
const countryFaqSchema = country ? buildFAQSchema(country.faqs) : null;
const countryBreadcrumbSchema = country ? buildBreadcrumbSchema([
  {
    name: 'Inicio',
    url: 'https://almaholistica.com/',
  },
  {
    name: country.pais,
    url: countryCanonicalUrl,
  },
]) : null;

// Variables específicas para City Page
const city = propCity || ({} as CityData);
const rawSlug = city.slug || (city as any)['URL Final (Slug)'] || '';
const rawH1 = city.h1 || (city as any)['H1 Título'] || '';
const cityName = rawH1
  .replace(/^Terapia de Biodescodificación Biológica en /i, '')
  .replace(/^Terapia Holística y Biodescodificación en /i, '')
  .trim() || (rawSlug ? rawSlug.replace(/^biodescodificacion-/i, '').charAt(0).toUpperCase() + rawSlug.replace(/^biodescodificacion-/i, '').slice(1) : 'Tu Ciudad');

const pageTitle = `Biodescodificación y Terapia Holística en ${cityName} | ${SITE_CONFIG.name}`;
const h1Title = `Biodescodificación y Terapia Holística ${cityName}`;
const subtitleText = 'Acompañamiento holístico para decodificar el origen emocional de tus síntomas físicos.';
const metaDesc = city.metaDescripcion || (city as any)['Meta Descripción'] || `Sesiones online de biodescodificación y terapia holística en ${cityName}, ${city.pais}. Sanación emocional profunda, equilibrio mente-cuerpo y alivio de síntomas. Agenda tu sesión.`;
const moneda = city.moneda || (city as any)['Moneda'] || 'USD';
const precio = city.rangoPrecio || (city as any)['Rango_Precio_Sesion'] || `Consultar tarifas locales (${moneda})`;
const historiaLocal = city.historiaLocal || (city as any)['Historia_Local'] || '';
const pais = city.pais || (city as any)['País'] || '';

// Mapeo e integración E-E-A-T y Autoridad Clínica (Hito GEO-M1 / R4)
const cleanCitySlug = rawSlug.replace(/^biodescodificacion-/i, '').toLowerCase().trim();
const eeatRecord = (eeatCitiesData as any[]).find(
  (item: any) => item['URL Final (Slug)'].toLowerCase().trim() === cleanCitySlug
) || eeatCitiesData[0];

const especialistaNombre = eeatRecord.EEAT_Especialista_Nombre || 'Lic. Sofía Alarcón Valdés';
const especialistaCargo = eeatRecord.EEAT_Especialista_Cargo || 'Especialista Senior en Biodescodificación y Psicosomática Clínica';
const especialistaRegistro = eeatRecord.EEAT_Especialista_Registro || 'Reg. ITH-8492 (Asociación Internacional de Terapias Holísticas)';
const especialistaExperiencia = eeatRecord.EEAT_Especialista_Experiencia || '+9 años de práctica clínica y más de 1.400 sesiones individuales de biodescodificación guiadas.';
const especialistaFormacion = eeatRecord.EEAT_Especialista_Formacion || 'Diplomada en Descodificación Biológica de los Síntomas (Escuela Francesa), Máster en Psiconeuroinmunología Clínica y Acompañamiento Transgeneracional.';
const autoridadCientifica = eeatRecord.EEAT_Autoridad_Cientifica || 'Nuestra metodología clínica se fundamenta en los principios de la Psiconeuroinmunología (PNI), las leyes biológicas de la Nueva Medicina Germánica descritas por el Dr. Ryke Geerd Hamer, los modelos de descodificación biológica de Christian Flèche y la biología celular epigenética del Dr. Bruce Lipton.';
const confiabilidadDescargo = eeatRecord.EEAT_Confiabilidad_Descargo || 'Descargo de Responsabilidad Médica y Compromiso Ético: Las sesiones de biodescodificación y terapia holística ofrecidas por Alma Holística son intervenciones de acompañamiento emocional y bienestar complementario. En ningún caso sustituyen, reemplazan ni modifican el diagnóstico, prescripción médica o tratamiento facultativo alopático.';
const casosLocales = eeatRecord.EEAT_Experiencia_Casos_Locales || `Casos Clínicos Observados en ${cityName}: Los consultantes atendidos desde ${cityName} reportan con frecuencia somatizaciones gastrointestinales y sobrecarga tensional.`;
const especialistaIniciales = especialistaNombre
  .replace(/^(Lic\.|Dr\.|Dra\.)\s*/i, '')
  .split(' ')
  .filter(Boolean)
  .slice(0, 2)
  .map((w: string) => w[0])
  .join('') || 'AH';

// URL Canónica oficial con trailing slash (conforme a astro.config.mjs)
const canonicalUrl = `https://almaholistica.com/${rawSlug}/`;

// Schemas JSON-LD Estructurados (HealthAndBeautyBusiness + BreadcrumbList) conforme a Cruce 1
const localBusinessSchema = buildLocalServiceSchema(city, canonicalUrl);

// Silo Piramidal: Vinculación Canónica del Hub de País
const cityCountrySlug = countryNameToSlug(pais);
const countryHubUrl = `https://almaholistica.com/biodescodificacion-${cityCountrySlug}/`;

const breadcrumbSchema = buildBreadcrumbSchema([
  {
    name: 'Inicio',
    url: 'https://almaholistica.com/',
  },
  {
    name: pais,
    url: countryHubUrl,
  },
  {
    name: cityName,
    url: canonicalUrl,
  },
]);

// Generación de URL de WhatsApp estructurada para progressive enhancement
const fallbackWhatsAppUrl = buildWhatsAppUrl({
  location: `${cityName}, ${pais}`,
});
---

{isCountry && country ? (
  <BaseLayout
    title={countryPageTitle}
    description={countryMetaDesc}
    canonical={countryCanonicalUrl}
  >
    <Fragment slot="schema">
      {countryMedicalSchema && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(countryMedicalSchema)} />
      )}
      {countryFaqSchema && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(countryFaqSchema)} />
      )}
      {countryBreadcrumbSchema && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(countryBreadcrumbSchema)} />
      )}
    </Fragment>

    <CountryHubView country={country} />
  </BaseLayout>
) : (
  <BaseLayout
    title={pageTitle}
    description={metaDesc}
    canonical={canonicalUrl}
  >
    <Fragment slot="schema">
      <script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
      <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    </Fragment>

    <!-- ========================================================================= -->
    <!-- HERO HIPERLOCAL SWISS BIO-TECH // ESTADO EN VIVO Y ALTA CONVERSIÓN       -->
    <!-- ========================================================================= -->
    <section class="relative w-full bg-[#060A1A] pt-8 pb-16 sm:pt-12 sm:pb-24 border-b border-slate-800/40 overflow-hidden">
      <div class="hero-floating-aura absolute -top-40 left-1/4 w-[35rem] h-[35rem] bg-[#779DD1]/5 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

      <div class="max-w-7xl mx-auto px-6 lg:px-12 relative z-10">
        
        <!-- Migas de pan modernas (Silo Piramidal: Inicio > País > Ciudad) -->
        <nav class="flex items-center gap-2 text-xs font-sans tracking-wide text-slate-400 mb-8" aria-label="Breadcrumb">
          <a href="/" class="hover:text-[#779DD1] transition-colors">INICIO</a>
          <span class="text-slate-600">/</span>
          <a href={`/biodescodificacion-${cityCountrySlug}/`} class="hover:text-[#779DD1] transition-colors uppercase">{pais}</a>
          <span class="text-slate-600">/</span>
          <span class="text-[#779DD1] font-semibold uppercase">{cityName}</span>
        </nav>

      <!-- Bloque Hero en Retícula de 2 Columnas: Contenido a la izquierda + Arte Circular a la derecha -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center min-h-[40vh] mb-12">
        
        <!-- Columna Izquierda: Copy Hero y Acciones Clínicas -->
        <div class="lg:col-span-7 xl:col-span-8 flex flex-col items-start text-left">
          
          <!-- Micro-código de cabecera con punto verde pulsante -->
          <div class="inline-flex items-center gap-2.5 text-xs font-sans font-semibold tracking-wider text-[#779DD1] uppercase mb-6">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>SESIONES ONLINE EN VIVO • {pais.toUpperCase()}</span>
          </div>

          <!-- Titular Monumental Plus Jakarta Sans (H1 Dinámico en Caja Mixta Natural) -->
          <h1 class="font-sans font-extrabold text-3xl sm:text-5xl lg:text-6xl tracking-tight leading-[1.12] text-white max-w-4xl mb-6">
            {h1Title}
          </h1>

          <!-- Subtítulo del Hero (Legibilidad Superior) -->
          <p class="text-base sm:text-lg lg:text-xl text-slate-700 dark:text-slate-200 font-sans font-medium max-w-3xl leading-relaxed mb-4">
            {subtitleText}
          </p>

          <!-- Propuesta de valor local -->
          <p class="text-sm sm:text-base text-slate-300 font-sans max-w-3xl leading-relaxed mb-8">
            {metaDesc}
          </p>

          <!-- Indicadores Clave de la Sesión (Swiss Bio-Tech con bordes coloreados) -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8 w-full max-w-3xl">
            <div class="card-matte p-5 border-l-4 border-l-[#779DD1] flex flex-col justify-center">
              <span class="text-xs font-sans font-medium uppercase tracking-wider text-slate-400 mb-1">Rango por Sesión</span>
              <span class="text-lg sm:text-xl font-bold font-sans text-white">{precio}</span>
              <span class="text-xs text-slate-400 mt-1 font-sans">Moneda local: {moneda}</span>
            </div>
            <div class="card-matte p-5 border-l-4 border-l-emerald-400 flex flex-col justify-center">
              <span class="text-xs font-sans font-medium uppercase tracking-wider text-slate-400 mb-1">Modalidad</span>
              <span class="text-lg sm:text-xl font-bold font-sans text-white">100% Online en Vivo</span>
              <span class="text-xs text-slate-400 mt-1 font-sans">Vía Zoom / Google Meet</span>
            </div>
            <div class="card-matte p-5 border-l-4 border-l-[#F97316] flex flex-col justify-center">
              <span class="text-xs font-sans font-medium uppercase tracking-wider text-slate-400 mb-1">Enfoque Clínico</span>
              <span class="text-lg sm:text-xl font-bold font-sans text-white">Biodescodificación</span>
              <span class="text-xs text-slate-400 mt-1 font-sans">Desactivación de origen biológico</span>
            </div>
          </div>

          <!-- Consultas Frecuentes: Bloque Fotográfico de Identificación de Síntomas -->
          <div class="w-full max-w-3xl mb-10 p-4 sm:p-5 rounded-2xl bg-[#0A1226] border border-slate-800/40">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
                <span class="text-xs font-bold uppercase tracking-wider text-[#779DD1]">
                  Consultas Frecuentes // Identifica tu Síntoma en {cityName}:
                </span>
              </div>
              <span class="text-xs text-slate-400 font-sans hidden sm:inline">
                Toca una dolencia para ver su origen biológico &rarr;
              </span>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
              <!-- 1. Estrés & Ansiedad -->
              <a
                href="/biodescodificacion/ansiedad"
                class="group rounded-xl border border-slate-800 bg-[#0E172F] p-2.5 flex flex-col justify-between transition-all duration-300 hover:scale-[1.02] hover:border-blue-500/50 block overflow-hidden"
              >
                <div class="w-full aspect-square rounded-lg overflow-hidden mb-2.5 relative bg-[#060A1A]">
                  <img
                    src="/images/sintoma-estres-ansiedad.webp"
                    alt={`Biodescodificación de estrés y ansiedad en ${cityName}`}
                    width="400"
                    height="400"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500"
                  />
                  <span class="absolute top-1.5 left-1.5 px-2 py-0.5 rounded text-[10px] font-bold bg-[#1E3A8A] text-[#93C5FD] border border-blue-700/50">
                    Nervioso
                  </span>
                </div>
                <div class="space-y-0.5">
                  <span class="text-xs sm:text-sm font-bold text-white block group-hover:text-[#779DD1] transition-colors">
                    Estrés & Ansiedad
                  </span>
                  <span class="text-[11px] text-slate-400 block font-normal leading-tight">
                    Opresión en pecho
                  </span>
                </div>
              </a>

              <!-- 2. Gastritis & Digestivo -->
              <a
                href="/biodescodificacion/gastritis"
                class="group rounded-xl border border-slate-800 bg-[#0E172F] p-2.5 flex flex-col justify-between transition-all duration-300 hover:scale-[1.02] hover:border-emerald-500/50 block overflow-hidden"
              >
                <div class="w-full aspect-square rounded-lg overflow-hidden mb-2.5 relative bg-[#060A1A]">
                  <img
                    src="/images/sintoma-gastritis-digestivo.webp"
                    alt={`Biodescodificación de gastritis y sistema digestivo en ${cityName}`}
                    width="400"
                    height="400"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500"
                  />
                  <span class="absolute top-1.5 left-1.5 px-2 py-0.5 rounded text-[10px] font-bold bg-[#064E3B] text-[#6EE7B7] border border-emerald-700/50">
                    Digestivo
                  </span>
                </div>
                <div class="space-y-0.5">
                  <span class="text-xs sm:text-sm font-bold text-white block group-hover:text-emerald-400 transition-colors">
                    Gastritis & Colon
                  </span>
                  <span class="text-[11px] text-slate-400 block font-normal leading-tight">
                    Ardor y pesadez
                  </span>
                </div>
              </a>

              <!-- 3. Espalda & Tensión -->
              <a
                href="/biodescodificacion/lumbalgia"
                class="group rounded-xl border border-slate-800 bg-[#0E172F] p-2.5 flex flex-col justify-between transition-all duration-300 hover:scale-[1.02] hover:border-[#F97316]/50 block overflow-hidden"
              >
                <div class="w-full aspect-square rounded-lg overflow-hidden mb-2.5 relative bg-[#060A1A]">
                  <img
                    src="/images/sintoma-espalda-tension.webp"
                    alt={`Biodescodificación de dolor de espalda y tensión lumbar en ${cityName}`}
                    width="400"
                    height="400"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500"
                  />
                  <span class="absolute top-1.5 left-1.5 px-2 py-0.5 rounded text-[10px] font-bold bg-[#7C2D12] text-[#FFEDD5] border border-[#9A3412]/50">
                    Osteoarticular
                  </span>
                </div>
                <div class="space-y-0.5">
                  <span class="text-xs sm:text-sm font-bold text-white block group-hover:text-[#F97316] transition-colors">
                    Espalda & Tensión
                  </span>
                  <span class="text-[11px] text-slate-400 block font-normal leading-tight">
                    Carga lumbar
                  </span>
                </div>
              </a>

              <!-- 4. Migrañas & Cefalea -->
              <a
                href="/biodescodificacion/migrana"
                class="group rounded-xl border border-slate-800 bg-[#0E172F] p-2.5 flex flex-col justify-between transition-all duration-300 hover:scale-[1.02] hover:border-purple-500/50 block overflow-hidden"
              >
                <div class="w-full aspect-square rounded-lg overflow-hidden mb-2.5 relative bg-[#060A1A]">
                  <img
                    src="/images/sintoma-migrana-cefalea.webp"
                    alt={`Biodescodificación de migraña y dolor de cabeza en ${cityName}`}
                    width="400"
                    height="400"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500"
                  />
                  <span class="absolute top-1.5 left-1.5 px-2 py-0.5 rounded text-[10px] font-bold bg-[#581C87] text-[#D8B4FE] border border-purple-700/50">
                    Cefaleas
                  </span>
                </div>
                <div class="space-y-0.5">
                  <span class="text-xs sm:text-sm font-bold text-white block group-hover:text-purple-400 transition-colors">
                    Migrañas & Cefalea
                  </span>
                  <span class="text-[11px] text-slate-400 block font-normal leading-tight">
                    Presión en sienes
                  </span>
                </div>
              </a>
            </div>
          </div>

          <!-- Acciones Principales: Botón WhatsApp Esmeralda Oficial (#25D366) + Explorar Dolencias -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-5 w-full sm:w-auto">
            <a
              href={fallbackWhatsAppUrl}
              data-open-quiz="true"
              data-city={cityName}
              data-city-slug={rawSlug}
              class="btn-whatsapp-primary inline-flex items-center justify-center gap-3 px-8 py-4 rounded-full text-base font-sans font-bold shadow-lg focus:outline-none focus:ring-2 focus:ring-[#25D366]"
            >
              <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 448 512" width="20" height="20" aria-hidden="true">
                <path fill="currentColor" d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
              </svg>
              <span>Iniciar Evaluación en {cityName}</span>
            </a>

            <a
              href="/biodescodificacion"
              class="group inline-flex items-center gap-2 text-sm text-slate-300 hover:text-[#779DD1] font-sans font-semibold py-3.5 px-4 transition-colors"
            >
              <span>[EXPLORAR DOLENCIAS FÍSICAS]</span>
              <span class="group-hover:translate-x-1.5 transition-transform duration-300" aria-hidden="true">&rarr;</span>
            </a>
          </div>

        </div>

        <!-- Columna Derecha: Fotografía Realista en Contenedor Circular de Sesión Online -->
        <div class="lg:col-span-5 xl:col-span-4 flex flex-col justify-center items-center relative">
          
          <!-- Contenedor Circular Rígido de Alta Gama (CLS = 0, Cero Neón) -->
          <div class="relative w-64 h-64 sm:w-80 sm:h-80 md:w-88 md:h-88 lg:w-96 lg:h-96 rounded-full p-2 bg-[#0A1226] border-2 border-slate-800 shadow-2xl flex items-center justify-center shrink-0">
            <div class="w-full h-full rounded-full overflow-hidden border border-slate-700/60 bg-[#060A1A] relative flex items-center justify-center">
              <img
                src="/images/sesion-online-en-casa.webp"
                alt={`Sesión online de biodescodificación y terapia holística en ${cityName}`}
                width="1024"
                height="1024"
                loading="eager"
                decoding="async"
                class="w-full h-full object-cover rounded-full filter drop-shadow-[0_10px_25px_rgba(0,0,0,0.5)] transform hover:scale-105 transition-transform duration-700 ease-out"
              />
            </div>

            <!-- Insignia Técnica Inferior: 100% Online en Vivo -->
            <div class="absolute -bottom-2 bg-[#0A1226] border border-slate-700 rounded-full px-4 py-1.5 shadow-lg flex items-center gap-2 text-xs font-sans text-slate-300">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span class="font-medium tracking-wide uppercase">100% Online en Vivo</span>
            </div>
          </div>

        </div>

      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SECCIÓN PUENTE EXPLICATIVA "¿QUÉ ES LA BIODESCODIFICACIÓN?"               -->
  <!-- ========================================================================= -->
  <section class="w-full bg-[#060A1A] py-16 sm:py-20 border-b border-slate-800/40" aria-label="Introducción a la Biodescodificación">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
