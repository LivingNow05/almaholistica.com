---
/**
 * src/pages/sobre-nosotros.astro — Sobre Nosotros y Fundadora Vivian Velásquez
 * Alma Holística (almaholistica.com)
 *
 * Página institucional de alta autoridad clínica y calidez humana:
 * - Trayectoria profesional y personal de la fundadora Vivian Velásquez.
 * - Retrato oficial de alta calidad con optimización responsive.
 * - Misión, valores y los 4 pilares metodológicos de Alma Holística.
 * - Integración oficial de Google Reviews (https://share.google/otrUm918xRGNHTTkE).
 * - Conversión integrada mediante WhatsAppQuizModal (data-open-quiz="true").
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_CONFIG, buildWhatsAppUrl } from '../config/site';
import GoogleReviewsSection from '../components/GoogleReviewsSection.astro';

const pageTitle = `Sobre Nosotros | Vivian Velásquez, Fundadora de Alma Holística`;
const metaDesc = `Conoce la historia, visión y trayectoria clínica de Vivian Velásquez, fundadora de Alma Holística. Más de una década acompañando a personas en 20 países a decodificar el origen emocional de sus síntomas físicos.`;
const canonicalUrl = `https://almaholistica.com/sobre-nosotros/`;
const googleReviewsUrl = SITE_CONFIG.googleReviewsUrl || 'https://share.google/otrUm918xRGNHTTkE';

const whatsappCtaUrl = buildWhatsAppUrl({
  location: 'Sobre Nosotros — Perfil Fundadora'
});

// Esquema estructurado Schema.org (AboutPage + Person + BreadcrumbList)
const aboutPageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AboutPage',
      '@id': 'https://almaholistica.com/sobre-nosotros/#webpage',
      'url': 'https://almaholistica.com/sobre-nosotros/',
      'name': pageTitle,
      'description': metaDesc,
      'inLanguage': 'es',
      'isPartOf': {
        '@type': 'WebSite',
        '@id': 'https://almaholistica.com/#website',
        'name': SITE_CONFIG.name,
        'url': 'https://almaholistica.com'
      }
    },
    {
      '@type': 'Person',
      '@id': 'https://almaholistica.com/sobre-nosotros/#founder',
      'name': 'Vivian Velásquez',
      'jobTitle': 'Fundadora y Directora Clínica',
      'worksFor': {
        '@type': 'Organization',
        'name': 'Alma Holística',
        'url': 'https://almaholistica.com'
      },
      'image': 'https://almaholistica.com/images/vivian-velasquez.jpg',
      'description': 'Especialista en Biodescodificación Biológica, Psiconeuroinmunología y Salud Emocional Integrativa. Fundadora de Alma Holística.',
      'knowsAbout': [
        'Biodescodificación Biológica',
        'Psiconeuroinmunología',
        'Psicogenealogía y Árbol Transgeneracional',
        'Medicina Mente-Cuerpo',
        'Gestión Emocional de Síntomas Físicos'
      ]
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://almaholistica.com/sobre-nosotros/#breadcrumb',
      'itemListElement': [
        {
          '@type': 'ListItem',
          'position': 1,
          'name': 'Inicio',
          'item': 'https://almaholistica.com/'
        },
        {
          '@type': 'ListItem',
          'position': 2,
          'name': 'Sobre Nosotros',
          'item': 'https://almaholistica.com/sobre-nosotros/'
        }
      ]
    }
  ]
};
---

<BaseLayout
  title={pageTitle}
  description={metaDesc}
  canonical={canonicalUrl}
  image="/images/vivian-velasquez.jpg"
>
  <Fragment slot="schema">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(aboutPageSchema)} />
  </Fragment>

  <!-- ========================================================================= -->
  <!-- HERO INSTITUCIONAL // HISTORIA & VISIÓN                                  -->
  <!-- ========================================================================= -->
  <section class="relative w-full bg-[#060A1A] pt-8 pb-16 sm:pt-14 sm:pb-24 border-b border-slate-800/40 overflow-hidden">
    <div class="hero-floating-aura absolute -top-40 left-1/3 w-[35rem] h-[35rem] bg-[#779DD1]/5 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Migas de pan (Breadcrumb) -->
      <nav class="flex items-center gap-2 text-xs font-sans tracking-wide text-slate-400 mb-8" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#779DD1] transition-colors">INICIO</a>
        <span class="text-slate-600">/</span>
        <span class="text-[#779DD1] font-semibold uppercase">SOBRE NOSOTROS</span>
      </nav>

      <!-- Badge Superior de Autoridad -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#0A1226] border border-slate-800 text-xs font-sans font-semibold tracking-wider text-[#779DD1] uppercase mb-6">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Fundación, Dirección Clínica &amp; Respaldo Humano</span>
      </div>

      <!-- Titular Monumental -->
      <h1 class="font-sans font-extrabold text-3xl sm:text-5xl lg:text-6xl tracking-tight leading-[1.14] text-white max-w-4xl mb-6">
        El cuerpo no enferma por error: expresa lo que el alma calla.
      </h1>

      <p class="text-base sm:text-xl text-slate-300 font-sans max-w-3xl leading-relaxed mb-8">
        Conoce la trayectoria de <strong class="text-white font-semibold">Vivian Velásquez</strong> y el propósito que dio origen a <strong class="text-[#779DD1] font-semibold">Alma Holística</strong>: democratizar la biodescodificación clínica y el acompañamiento bioemocional con rigor, calidez y accesibilidad para personas de todo el mundo hispano.
      </p>

      <!-- Badges de Respaldo Rápido -->
      <div class="flex flex-wrap items-center gap-3 sm:gap-4 text-xs sm:text-sm text-slate-300">
        <div class="flex items-center gap-2 px-3.5 py-2 rounded-xl bg-[#0A1226] border border-slate-800/80">
          <span class="text-emerald-400 font-bold">✓</span>
          <span>+10 Años de Trayectoria</span>
        </div>
        <div class="flex items-center gap-2 px-3.5 py-2 rounded-xl bg-[#0A1226] border border-slate-800/80">
          <span class="text-emerald-400 font-bold">✓</span>
          <span>+1.400 Casos Acompañados</span>
        </div>
        <a
          href={googleReviewsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 px-3.5 py-2 rounded-xl bg-emerald-500/10 border border-emerald-600/30 dark:border-emerald-500/25 text-emerald-900 dark:text-emerald-400 hover:bg-emerald-500/20 transition-colors"
        >
          <span class="text-amber-500 dark:text-amber-400">★★★★★</span>
          <span class="font-semibold text-emerald-950 dark:text-emerald-300">5.0 en Google Reviews</span>
          <span class="text-xs">&rarr;</span>
        </a>
      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SECCIÓN BIOGRÁFICA // VIVIAN VELÁSQUEZ & SU TRAYECTORIA                  -->
  <!-- ========================================================================= -->
  <section class="w-full bg-[#060A1A] py-16 sm:py-24 border-b border-slate-800/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        
        <!-- Columna Izquierda: Retrato de Vivian + Tarjeta de Confianza -->
        <div class="lg:col-span-5 flex flex-col items-center">
          
          <!-- Contenedor de Fotografía con Marco Editorial -->
          <div class="relative w-full max-w-md rounded-3xl overflow-hidden bg-[#0A1226] border-2 border-slate-800 shadow-2xl p-2.5">
            <div class="relative w-full aspect-[3/4] rounded-2xl overflow-hidden bg-slate-900">
              <img
                src="/images/vivian-velasquez.jpg"
                alt="Vivian Velásquez — Fundadora y Directora de Alma Holística"
                class="w-full h-full object-cover object-top filter contrast-[1.02] hover:scale-105 transition-transform duration-700"
                width="600"
                height="800"
                loading="eager"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#060A1A] via-transparent to-transparent opacity-60"></div>
              
              <div class="absolute bottom-4 left-4 right-4 p-4 rounded-xl bg-[#060A1A] border border-slate-800 text-left">
                <span class="text-xs uppercase tracking-wider text-[#779DD1] font-bold block mb-0.5">
                  Fundadora &amp; Directora
                </span>
                <span class="text-lg font-bold text-white block">
                  Vivian Velásquez
                </span>
                <span class="text-xs text-slate-300 block">
                  Terapeuta Clínica en Biodescodificación &amp; Salud Emocional
                </span>
              </div>
            </div>
          </div>

          <!-- Tarjeta de Acreditaciones y Aval Clínico -->
          <div class="w-full max-w-md mt-6 p-6 rounded-2xl bg-[#0A1226] border border-slate-800/80 space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-slate-800/60">
              <span class="text-xs font-bold uppercase tracking-wider text-[#779DD1]">Enfoque Metodológico</span>
              <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400">Certificada</span>
            </div>
            <ul class="space-y-2.5 text-xs sm:text-sm text-slate-300">
              <li class="flex items-start gap-2">
                <span class="text-[#779DD1] mt-0.5">•</span>
                <span><strong>Psiconeuroinmunología Clínica (PNI):</strong> Diálogo mente, sistema inmune y endocrino.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#779DD1] mt-0.5">•</span>
                <span><strong>Biodescodificación Biológica:</strong> Modelos de Christian Flèche y leyes biológicas.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#779DD1] mt-0.5">•</span>
                <span><strong>Árbol Transgeneracional:</strong> Desactivación de lealtades y memorias heredadas.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[#779DD1] mt-0.5">•</span>
                <span><strong>Biología de las Creencias:</strong> Epigenética y plasticidad neuro-celular (Dr. Bruce Lipton).</span>
              </li>
            </ul>

            <!-- Enlace oficial a Reseñas en Google -->
            <div class="pt-2">
              <a
                href={googleReviewsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-900 dark:text-emerald-400 border border-emerald-600/30 dark:border-emerald-500/30 text-xs font-bold uppercase tracking-wider transition-all duration-300 text-center"
              >
                <span class="text-amber-500 dark:text-amber-400">⭐</span>
                <span>Ver Opiniones de Consultantes en Google</span>
                <span>&rarr;</span>
              </a>
            </div>
          </div>

        </div>

        <!-- Columna Derecha: Narrativa de Trayectoria & Propósito -->
        <div class="lg:col-span-7 space-y-8 text-left">
          
          <div>
            <span class="text-xs font-bold uppercase tracking-widest text-[#779DD1] block mb-2">
              Trayectoria &amp; Propósito
            </span>
            <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-snug">
              De la somatización del dolor a la comprensión biológica del ser
            </h2>
          </div>

          <!-- Párrafo 1: El Origen y el Despertar -->
          <div class="p-6 rounded-2xl bg-[#0A1226] border border-slate-800/60 space-y-3">
            <h3 class="text-lg font-bold text-white flex items-center gap-2">
              <span class="text-xl">🌱</span>
              <span>1. El inicio de la búsqueda</span>
            </h3>
            <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
              La historia de Vivian Velásquez con la biodescodificación no nació de una teoría académica, sino de una vivencia profunda: la observación reiterada de personas cercanas y de sí misma que enfrentaban síntomas físicos recurrentes —migrañas, colon irritable, gastritis o dolores lumbares— sin encontrar una respuesta definitiva en los diagnósticos tradicionales que solo ofrecían paliar temporalmente las molestias.
            </p>
            <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
              Esta inquietud vital la condujo a una pregunta fundamental: <em>«¿Por qué el cuerpo reacciona en un órgano específico y en un momento exacto de la vida?»</em>. La respuesta la encontró en la unión indisoluble entre la psique, el sistema nervioso y la biología de supervivencia.
            </p>
          </div>

          <!-- Párrafo 2: La Formación Rigurosa -->
          <div class="p-6 rounded-2xl bg-[#0A1226] border border-slate-800/60 space-y-3">
            <h3 class="text-lg font-bold text-white flex items-center gap-2">
              <span class="text-xl">📚</span>
              <span>2. Rigor científico sin misticismo</span>
            </h3>
            <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
              Comprometida con ofrecer una práctica seria y desprovista de dogmas o falsas promesas milagrosas, Vivian se formó exhaustivamente en las principales escuelas internacionales de medicina mente-cuerpo, estudiando a fondo los postulados de la Psiconeuroinmunología, la descodificación según Christian Flèche y los principios de la epigenética conductual.
            </p>
            <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
              Su enfoque clínico sostiene que <strong>el síntoma es un programa biológico con pleno sentido adaptativo</strong>: el intento desesperado del cuerpo por gestionar una emoción de alto impacto que no pudo ser verbalizada, procesada ni liberada en su momento.
            </p>
          </div>

          <!-- Párrafo 3: La Creación de Alma Holística -->
          <div class="p-6 rounded-2xl bg-[#0A1226] border border-slate-800/60 space-y-3">
            <h3 class="text-lg font-bold text-white flex items-center gap-2">
              <span class="text-xl">🦋</span>
              <span>3. El nacimiento de Alma Holística</span>
            </h3>
            <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
              Con más de 1.400 procesos terapéuticos documentados a lo largo de una década, Vivian fundó <strong>Alma Holística</strong> con una misión clara: acercar esta metodología a cualquier persona de habla hispana, sin importar si reside en Madrid, Bogotá, Ciudad de México, Buenos Aires, Miami o Santiago de Chile.
            </p>
            <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
              A través de un sistema online de videollamada 1 a 1 confidencial, cálido y riguroso, el consultante accede a un acompañamiento de alta precisión desde su hogar, adaptado a su zona horaria y moneda local, eliminando el estrés de los traslados y las listas de espera.
            </p>
          </div>

          <!-- Cita Destacada de Vivian -->
          <blockquote class="p-6 rounded-2xl bg-[#0E172F] border-l-4 border-l-[#779DD1] text-slate-200 italic font-serif text-lg sm:text-xl leading-relaxed">
            «Cuando una persona comprende con exactitud qué impacto emocional encendió la alarma de su cuerpo, el organismo deja de necesitar el síntoma. Sanar no es luchar contra el cuerpo: es aprender a escuchar su lenguaje biológico.»
            <footer class="mt-3 text-sm font-sans font-bold text-[#779DD1] not-italic">
              — Vivian Velásquez, Fundadora de Alma Holística
            </footer>
          </blockquote>

          <!-- Botones de Acción Inmediata -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-4">
            <a
              href={whatsappCtaUrl}
              data-open-quiz="true"
              data-location="sobre-nosotros-hero"
              data-symptom=""
              class="inline-flex items-center justify-center gap-2 px-8 py-4 rounded-full bg-white text-[#060A1A] font-bold text-sm uppercase tracking-wider hover:bg-[#779DD1] hover:text-[#060A1A] transition-all duration-300 shadow-xl cursor-pointer"
            >
              <span>Iniciar Evaluación de Síntomas</span>
              <span>&rarr;</span>
            </a>
            <a
              href={googleReviewsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-6 py-4 rounded-full bg-slate-100 dark:bg-[#0A1226] text-slate-900 dark:text-slate-200 border border-slate-300 dark:border-slate-700 hover:border-[#779DD1] hover:text-[#779DD1] font-semibold text-sm transition-all duration-300"
            >
              <span class="text-amber-500 dark:text-amber-400">⭐</span>
              <span>Ver Reseñas en Google</span>
            </a>
          </div>

        </div>

      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- LOS 4 PILARES METODOLÓGICOS DE ALMA HOLÍSTICA                            -->
  <!-- ========================================================================= -->
  <section class="w-full bg-[#060A1A] py-16 sm:py-24 border-b border-slate-800/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      
      <span class="text-xs font-bold uppercase tracking-widest text-[#779DD1] block mb-2">
        Nuestros Principios Clínicos
      </span>
      <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
        Los 4 Pilares de la Consulta en Alma Holística
      </h2>
      <p class="text-slate-300 font-sans text-sm sm:text-base max-w-2xl mx-auto mb-14 leading-relaxed">
        Cada sesión se fundamenta en un marco ético, científico y humano diseñado para acompañarte hacia la causa raíz de tu síntoma con total respeto y confidencialidad.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 text-left">
        
        <!-- Pilar 1 -->
        <div class="p-6 rounded-2xl bg-[#0A1226] border border-slate-800/60 hover:border-[#779DD1]/50 transition-all flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-[#0E172F] border border-slate-700 flex items-center justify-center text-2xl mb-4">
              🎯
            </div>
            <h3 class="text-lg font-bold text-white mb-2">
              01. Causa Raíz Inconsciente
            </h3>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              No tapamos el síntoma con afirmaciones genéricas. Rastrearemos el evento biográfico o transgeneracional exacto donde se programó el choque biológico no verbalizado.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-800/40 text-xs text-[#779DD1] font-semibold">
            Desactivación de origen
          </div>
        </div>

        <!-- Pilar 2 -->
        <div class="p-6 rounded-2xl bg-[#0A1226] border border-slate-800/60 hover:border-[#779DD1]/50 transition-all flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-[#0E172F] border border-slate-700 flex items-center justify-center text-2xl mb-4">
              🧬
            </div>
            <h3 class="text-lg font-bold text-white mb-2">
              02. Rigor Científico &amp; PNI
            </h3>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              Fundamentado en Psiconeuroinmunología, leyes biológicas y epigenética. Cada órgano responde a un patrón emocional arquetípico respaldado por la fisiología médica.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-800/40 text-xs text-[#779DD1] font-semibold">
            Metodología documentada
          </div>
        </div>

        <!-- Pilar 3 -->
        <div class="p-6 rounded-2xl bg-[#0A1226] border border-slate-800/60 hover:border-[#779DD1]/50 transition-all flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-[#0E172F] border border-slate-700 flex items-center justify-center text-2xl mb-4">
              🔒
            </div>
            <h3 class="text-lg font-bold text-white mb-2">
              03. Intimidad 100% Online
            </h3>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              Sesiones privadas 1 a 1 por Zoom o Google Meet desde la calidez de tu hogar. Cero salas de espera, cero pérdidas de tiempo en traslados urbanos y máxima confidencialidad.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-800/40 text-xs text-[#779DD1] font-semibold">
            Atención en 20 países
          </div>
        </div>

        <!-- Pilar 4 -->
        <div class="p-6 rounded-2xl bg-[#0A1226] border border-slate-800/60 hover:border-[#779DD1]/50 transition-all flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-[#0E172F] border border-slate-700 flex items-center justify-center text-2xl mb-4">
              🤝
            </div>
            <h3 class="text-lg font-bold text-white mb-2">
              04. Ética Complementaria
            </h3>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
              Sumamos a tu bienestar. Nuestras sesiones jamás sustituyen ni interrumpen tu tratamiento médico alopático; complementan el cuidado de la salud desde la raíz emocional.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-800/40 text-xs text-[#779DD1] font-semibold">
            Compromiso deontológico
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- RESEÑAS VERIFICADAS EN GOOGLE (https://share.google/otrUm918xRGNHTTkE)     -->
  <!-- ========================================================================= -->
  <GoogleReviewsSection
    sectionId="opiniones"
    title="Opiniones de Consultantes en Google Reviews"
    subtitle="La experiencia real de personas que han transformado la relación con sus síntomas corporales a través de nuestras sesiones online."
    limit={6}
    showCta={false}
  />

  <!-- ========================================================================= -->
  <!-- CTA DE CONVERSIÓN FINAL // DA EL PRIMER PASO                            -->
  <!-- ========================================================================= -->
  <section class="w-full bg-[#060A1A] py-16 sm:py-24">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      
      <div class="p-8 sm:p-14 rounded-3xl bg-gradient-to-b from-[#0A1226] to-[#060A1A] border border-slate-800 shadow-2xl relative overflow-hidden">
        <div class="hero-floating-aura absolute -bottom-20 right-1/4 w-[25rem] h-[25rem] bg-[#779DD1]/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

        <span class="text-xs font-bold uppercase tracking-widest text-[#779DD1] block mb-3">
          Atención Activa en 20 Países
        </span>
        <h2 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight mb-6">
          ¿Sientes que tu cuerpo te está enviando una señal?
        </h2>
        <p class="text-sm sm:text-base text-slate-300 max-w-2xl mx-auto leading-relaxed mb-8">
          Haz el test de evaluación rápida de 4 pasos para recibir una primera lectura bioemocional sin costo y coordinar tu sesión personalizada con el equipo clínico de Alma Holística.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
